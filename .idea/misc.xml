public class BatchCloseManager implements BatchCloseManagerApi {

    private static final String TAG = "BatchCloseManager";
    private static final int REPORT_LOADER_ID = Ids.Loader.AUTO_BATCH_CLOSURE_BATCH_REPORT;
    private static final int TRANSFERS_LOADER_ID = Ids.Loader.AUTO_BATCH_CLOSURE_BATCH_TRANSFERS;
    private static final MainApplication APP = MainApplication.getInstance();

    @NonNull
    private final WeakReference<FragmentActivity> mActivityReference;
    @NonNull
    private final TxDbBatch mBatch;
    @NonNull
    private final BatchCloseActivityState mActivityState;
    @Nullable
    private final BatchCloseCallbacks mCallbacks;
    private final boolean mAreFinalizedTendersRequired;
    private final boolean mIsFiscalBatchClose;

    @NonNull
    private final Handler mHandler;
    @Nullable
    private TransactionsDao mDao;
    @Nullable
    private BatchReport mBatchReport;
    @Nullable
    private BatchReportDetailed mBatchReportDetailed;
    @Nullable
    private List<TxDbBatchTransfer> mBatchTransfers;
    @NonNull
    private final Date mAttemptedDateTime;
    @Nullable
    private BatchCloseTransactionCallbacks mUploadCallbacks;
    @Nullable
    private BatchCloseTenderCallbacks mActionCallbacks;
    @Nullable
    private BatchCloseTerminalBatchCloseCallbacks mTerminalCallbacks;

    public BatchCloseManager(@NonNull FragmentActivity activity,
            @NonNull TxDbBatch batch,
            @NonNull BatchCloseActivityState activityState,
            boolean areFinalizedTendersRequired,
            @Nullable BatchCloseCallbacks callbacks) {
        this(activity, batch, activityState, areFinalizedTendersRequired, false, callbacks);
    }

    public BatchCloseManager(@NonNull FragmentActivity activity,
            @NonNull TxDbBatch batch,
            @NonNull BatchCloseActivityState activityState,
            boolean areFinalizedTendersRequired,
            boolean isFiscalBatchClose,
            @Nullable BatchCloseCallbacks callbacks) {
        mActivityReference = new WeakReference<>(activity);
        mBatch = batch;
        mActivityState = activityState;
        mAreFinalizedTendersRequired = areFinalizedTendersRequired;
        mIsFiscalBatchClose = isFiscalBatchClose;
        mCallbacks = callbacks;
        mHandler = new Handler(MainApplication.getInstance().getMainLooper());
        mAttemptedDateTime = new Date();
    }

    @MainThread
    @Override
    public void begin() {
        LogHelper.invoked(Level.FINE, TAG);
        onStateChanged(BatchCloseState.CLOSING);

        checkBatchConditions(mBatch.getBatchNumber(), mAreFinalizedTendersRequired);
    }

    private void onBatchConditionsMet() {
        final Cursor cursor =
                getTransactionsDao()
                        .getAdjustTipsTenderList(mBatch.getBatchNumber(), Ids.UNDEFINED, true);
        if (cursor != null) {
            if (cursor.moveToFirst()) {
                finalizeTenderInFinalizeAllFlow(cursor);
            } else {
                cursor.close();
                restartBatchReportLoader();
            }
        } else {
            onFailure("Not able to get adjust tips tender list");
        }
    }

    // TODO: This is causing auto batch close to create cancelled transactions.
    //  Remove this method in a later release, if there is no side effects.
    @Deprecated
    private void disconnectPrimaryCart() {
        LogHelper.invoked(Level.FINE, TAG);
        if (!CartHelper.isCartEmpty()) {
            String cancelComment = getString(R.string.batch_close_disconnect_cart_reason);

            if (CartHelper.isOpenRefundInProgress()) {
                CartHelper.convertPrimaryCartToOpenRefund(TransactionStatusType.Cancelled,
                        TransactionRecordStatus.ReadyToUpload, cancelComment);
            } else {
                CartHelper.getCart().cancelTransaction(cancelComment,
                        CartHelper.getCartBatchOrderNumber(),
                        FlavorHelper.applyReceiptItemSort(CartHelper.getCart()),
                        TransactionRecordStatus.ReadyToUpload);
            }
        }

        CartHelper.clearCartReference(true);
    }

    private void finalizeTenderInFinalizeAllFlow(@NonNull final Cursor cursor) {
        final TxDbTender tender = getTransactionsDao().getTxDbTenderFromCursor(cursor);

        final BigDecimal tipAmount;
        if (tender.getAdditionalInfo().isTenderHasAdjustedTip()) {
            tipAmount = MathRules.zeroIfNull(tender.getTipAmount());
        } else {
            tipAmount = BigDecimal.ZERO;
        }

        FragmentActivity activity = mActivityReference.get();
        if (activity == null) {
            onActivityStateFailure();
            return;
        }
        new AdjustTipsUpdateTenderAndTransactionValuesTask(
                activity,
                tender.getTransactionNumber(),
                tender.getTenderNumber(),
                tipAmount) {
            @Override
            protected void onPostExecute(Long parentTransactionNumber) {
                captureTender(cursor, tender, tipAmount);
            }
        }.executeOnExecutor(AsyncTask.THREAD_POOL_EXECUTOR);
    }

    private void captureTender(@NonNull final Cursor cursor, @NonNull final TxDbTender tender,
            @NonNull final BigDecimal tipAmount) {
        FragmentActivity activity = mActivityReference.get();
        if (activity == null) {
            onActivityStateFailure();
            return;
        }
        TerminalHelper.captureTender(activity,
                activity.getClass(),
                tipAmount,
                tender,
                new BatchCloseTenderCaptureCallbacks(this, tender, cursor));
    }

    @Override
    public void onTerminalTenderCaptureSuccess(@NonNull TxDbTender tender,
            @NonNull PaymentTerminalResponse response, @NonNull Cursor cursor) {
        updateTenderAdditionalInfo(tender, response);
        completeFinalizeTenderActions(tender);
        processNextTender(cursor);
    }

    private void processNextTender(@NonNull Cursor cursor) {
        if (cursor.moveToNext()) {
            finalizeTenderInFinalizeAllFlow(cursor);
        } else {
            cursor.close();
            restartBatchReportLoader();
        }
    }

    private void onBatchReportLoaded(@Nullable List<BatchSummaryResponse> responses) {
        LogHelper.invoked(Level.FINE, TAG);
        if (responses != null && !responses.isEmpty() && responses.get(0) != null) {
            mBatchReport = responses.get(0).getBatchReport();
        }
        restartBatchReportDetailedLoader();
    }

    private void onBatchReportDetailedLoaded(@Nullable List<BatchSummaryResponse> responses) {
        LogHelper.invoked(Level.FINE, TAG);
        if (responses != null && !responses.isEmpty() && responses.get(0) != null) {
            mBatchReportDetailed = responses.get(0).getReportDetailed();
        }
        restartBatchTransfersLoader();
    }

    private void onBatchTransfersLoaded(@Nullable List<BatchSummaryResponse> responses) {
        LogHelper.invoked(Level.FINE, TAG);
        if (responses != null && !responses.isEmpty() && responses.get(0) != null) {
            mBatchTransfers = responses.get(0).getBatchTransferList();
        }
        populateBatchTotals();

        attachTerminalBatchCloseHelper();
    }

    @Override
    public void onTerminalBatchCloseSuccess() {
        LogHelper.invoked(Level.FINE, TAG);
        attachTenderActionHelper();
    }

    @Override
    public void onTenderActionsSuccess() {
        LogHelper.invoked(Level.FINE, TAG);
        attachTransactionUploader();
    }

    private void onTransactionUploadSuccess() {
        LogHelper.invoked(Level.FINE, TAG);
        closeServerBatch();
    }

    private void closeServerBatch() {
        LogHelper.invoked(Level.FINE, TAG);
        String processId = ProcessIdHelper.generate();
        closeServerBatch(0, processId);
    }

    private void onServerBatchClosed() {
        LogHelper.invoked(Level.FINE, TAG);
        onSuccess();
    }

    @NonNull
    private TransactionsDao getTransactionsDao() {
        if (mDao == null) {
            mDao = new TransactionsDao(MainApplication.getInstance());
        }
        return mDao;
    }

    //region Completion states
    @MainThread
    @Override
    public void onSuccess() {
        LogHelper.invoked(Level.FINE, TAG);

        TransactionUploadHelper.removeCallbacks(mUploadCallbacks);
        TenderActionHelper.removeCallbacks(mActionCallbacks);
        TerminalBatchCloseHelper.removeCallbacks(mTerminalCallbacks);

        onStateChanged(BatchCloseState.SUCCEEDED);
    }

    @MainThread
    @Override
    public void onFailure(String message) {
        LogHelper.invoked(Level.FINE, TAG, message);

        TransactionUploadHelper.removeCallbacks(mUploadCallbacks);
        TenderActionHelper.removeCallbacks(mActionCallbacks);
        TerminalBatchCloseHelper.removeCallbacks(mTerminalCallbacks);

        onStateChanged(BatchCloseState.FAILED);
    }
    //endregion

    //region Batch Loaders

    private void restartBatchReportLoader() {
        LogHelper.writeWithTrace(Level.FINE, TAG,
                "Invoked with BatchNumber: " + mBatch.getBatchNumber());

        mBatchReport = new BatchReport();

        FragmentActivity activity = mActivityReference.get();
        if (activity == null) {
            onActivityStateFailure();
            return;
        }

        LoaderManager loaderManager = LoaderManager.getInstance(activity);

        List<Long> batchNumbers = new ArrayList<>();
        batchNumbers.add(mBatch.getBatchNumber());
        loaderManager.restartLoader(
                REPORT_LOADER_ID,
                null,
                new BatchCloseBatchReportCallbacks(this, activity, batchNumbers));
    }

    private void restartBatchReportDetailedLoader() {
        LogHelper.writeWithTrace(Level.FINE, TAG,
                "Invoked with BatchNumber: " + mBatch.getBatchNumber());

        mBatchReportDetailed = new BatchReportDetailed();

        FragmentActivity activity = mActivityReference.get();
        if (activity == null) {
            onActivityStateFailure();
            return;
        }
        List<Long> batchNumbers = new ArrayList<>();
        batchNumbers.add(mBatch.getBatchNumber());
        BatchReportDetailedUseCase batchReportDetailUseCase =
                EntryPointAccessors.fromApplication(APP, BatchCloseManagerEntryPoint.class)
                        .getBatchReportDetailedUseCase();
        try {
            List<BatchSummaryResponse> batchSummaryResponses =
                    batchReportDetailUseCase.execute(batchNumbers);
            onBatchReportDetailedLoaded(batchSummaryResponses);
        } catch (Exception e) {
            LogHelper.write(TAG, "Error executing batchReportDetailUseCase: " + e.getMessage());
            onBatchReportDetailedLoaded(null);
        }
    }

    private void restartBatchTransfersLoader() {
        LogHelper.writeWithTrace(Level.FINE, TAG,
                "Invoked with BatchNumber: " + mBatch.getBatchNumber());

        mBatchTransfers = new ArrayList<>();

        FragmentActivity activity = mActivityReference.get();
        if (activity == null) {
            onActivityStateFailure();
            return;
        }

        LoaderManager loaderManager = LoaderManager.getInstance(activity);

        List<Long> batchNumbers = new ArrayList<>();
        batchNumbers.add(mBatch.getBatchNumber());
        loaderManager.restartLoader(
                TRANSFERS_LOADER_ID,
                null,
                new BatchCloseBatchTransfersCallbacks(this, activity, batchNumbers));
    }

    @Override
    public void onActivityStateFailure() {
        onFailure("Invalid state. Activity is not available.");
    }

    @Override
    public void onBatchLoaderSuccess(@Nullable final List<BatchSummaryResponse> data,
            final int loaderId) {
        // this loader should only run again when prompted
        destroyLoader(loaderId);

        mHandler.post(() -> {
            if (loaderId == REPORT_LOADER_ID) {
                onBatchReportLoaded(data);
            } else {
                onBatchTransfersLoaded(data);
            }
        });
    }

    //endregion

    //region Batch Values Calculations

    private void populateBatchTotals() {
        if (mBatchReport != null && mBatchTransfers != null) {
            BatchTotals batchTotals =
                    BatchTotals.populate(mBatchReport.getDeposits(), mBatchTransfers);
            batchTotals.calculateOverShortTotals();
            mBatchReport.setDeposits(batchTotals.finalizeBatchDeposits(mBatchReport.getDeposits()));
        } else {
            onFailure("Unable to generate batch report and transfers");
        }
    }

    //endregion

    //region Terminal SAF upload & batch closure

    private void attachTerminalBatchCloseHelper() {
        if (mTerminalCallbacks == null) {
            mTerminalCallbacks = new BatchCloseTerminalBatchCloseCallbacks(this);
        }
        if (TerminalBatchCloseHelper.isRunning()) {
            TerminalBatchCloseHelper.addCallbacks(mTerminalCallbacks);
        } else {
            FragmentActivity activity = mActivityReference.get();
            if (activity == null) {
                onActivityStateFailure();
                return;
            }

            try {
                new TerminalBatchCloseHelper(activity, mBatch, mTerminalCallbacks);
            } catch (IllegalArgumentException e) {
                LogHelper.write(TAG, "BatchCloseManager terminal batch close failed: " + e.getMessage());
                mTerminalCallbacks.TerminalBatchCloseOnError();
            }
        }
    }

    //endregion

    //region Tender Actions

    private void attachTenderActionHelper() {
        if (mActionCallbacks == null) {
            mActionCallbacks = new BatchCloseTenderCallbacks(this);
        }
        if (TenderActionHelper.isRunning()) {
            TenderActionHelper.addCallbacks(mActionCallbacks);
            TenderActionHelper.restart();
        } else {
            new TenderActionHelper(mActionCallbacks);
        }
    }

    //endregion

    //region Transaction Uploader

    private void attachTransactionUploader() {
        if (mUploadCallbacks == null) {
            mUploadCallbacks = new BatchCloseTransactionCallbacks(this);
        }
        if (TransactionUploadHelper.isRunning()) {
            TransactionUploadHelper.addCallbacks(mUploadCallbacks);
            TransactionUploadHelper.restart();
        } else {
            new TransactionUploadHelper(mUploadCallbacks);
        }
    }

    @Override
    public void onTransactionActionsSuccess(boolean checkForMoreTransactions) {
        if (checkForMoreTransactions &&
                BatchHelper.hasActionableTransactions(mBatch.getBatchNumber())) {
            // Additional protection against missed transactions
            attachTransactionUploader();
        } else {
            LogHelper.write(TAG, "TransactionUploadOnComplete");
            onTransactionUploadSuccess();
        }
    }

    //endregion

    //region Server Batch

    private void closeServerBatch(final int attempt, @NonNull final String processId) {
        FragmentActivity activity = mActivityReference.get();
        if (activity == null) {
            onActivityStateFailure();
            return;
        }

        // for automatic closure use the userId of the batch opener
        final int closeUserId = mBatch.getOpenUserId();
        final List<BatchDepositDto> deposits;
        if (mBatchReport != null) {
            deposits = mBatchReport.getDeposits();
        } else {
            deposits = null;
        }

        // For fiscal countries, transfers are already posted individually to server
        // so we don't include them in the batch close request
        final List<TxDbBatchTransfer> transfersToSend = mIsFiscalBatchClose ? null : mBatchTransfers;

        final BatchCloseDto request = BatchHelper.getBatchCloseRequest(
                mBatch.getBatchNumber(),
                new Date(),
                closeUserId,
                true,
                transfersToSend,
                deposits);

        new BatchCloseTask(activity, request, processId) {
            @Override
            protected void onPostExecute(Response<BatchDto> response) {
                super.onPostExecute(response);
                handleServerBatchCloseResponse(attempt, request, response, processId);
            }
        }.executeOnExecutor(AsyncTask.THREAD_POOL_EXECUTOR);
    }

    private void handleServerBatchCloseResponse(int attempt, @NonNull BatchCloseDto request,
            @NonNull Response<BatchDto> response, @NonNull String processId) {
        if (response.isSuccessful()
                || response.isNotFound()) {
            BatchManager batchManager = EntryPointAccessors.fromApplication(
                    APP, BatchCloseManagerEntryPoint.class).getBatchManager();
            batchManager.closeBatch(mBatch.getBatchNumber(), request.getCloseDateTime(),
                    request.getCloseUserId());
            onServerBatchClosed();
        } else if (response.isDtoNull()) {
            onFailure("Batch close response from server is null");
        } else if (response.isRetryable()) {
            if (response.shouldResetProcessId()) {
                processId = ProcessIdHelper.generate();
            }
            if (attempt >= Defaults.NONBLOCKING_MAX_AUTO_RETRIES) {
                onFailure("Exhausted all attempts to close server batch");
            } else {
                closeServerBatch(attempt + 1, processId);
            }
        } else {
            RequestResponseAuditHelper.sendHttpLogEvent(TAG, response.getDto());
            onFailure("Error closing server batch - see RequestResponse audits for details");
        }
    }

    //endregion

    //region Batch conditions

    private void checkBatchConditions(final long batchNumber,
            final boolean areFinalizedTendersRequired) {
        final FragmentActivity activity = mActivityReference.get();
        if (activity == null) {
            onActivityStateFailure();
            return;
        }
        new AsyncTask<Void, Void, Boolean>() {
            @NonNull
            @Override
            protected Boolean doInBackground(Void... params) {
                return canFinalizeTenders(activity, batchNumber, areFinalizedTendersRequired);
            }

            @Override
            protected void onPostExecute(@NonNull final Boolean canFinalize) {
                super.onPostExecute(canFinalize);
                if (canFinalize) {
                    onBatchConditionsMet();
                } else {
                    onFailure("Batch contains unfinalized tenders and auto-finalize not allowed");
                }
            }
        }.executeOnExecutor(AsyncTask.THREAD_POOL_EXECUTOR);
    }

    @WorkerThread
    private boolean canFinalizeTenders(@NonNull Context context, long batchNumber,
            boolean areFinalizedTendersRequired) {
        boolean hasUnfinalizedTenders = false;

        TransactionsDao dao = new TransactionsDao(context.getApplicationContext());
        Cursor cursor = dao.getAdjustTipsTenderList(batchNumber, Ids.UNDEFINED, true);
        if (cursor.moveToFirst()) {
            hasUnfinalizedTenders = true;
        }
        cursor.close();

        return !(areFinalizedTendersRequired && hasUnfinalizedTenders);
    }

    //endregion

    @SuppressWarnings("SameParameterValue")
    private String getString(@StringRes int res) {
        return AppLocaleHelper.getResources().getString(res);
    }

    private void destroyLoader(int loaderId) {
        FragmentActivity activity = mActivityReference.get();
        if (activity != null) {
            LoaderManager loaderManager = LoaderManager.getInstance(activity);
            loaderManager.destroyLoader(loaderId);
        }
    }

    @MainThread
    private void onStateChanged(@BatchCloseState int batchCloseState) {
        LogHelper.invoked(Level.FINE, TAG);

        if (mCallbacks != null) {
            BatchCloseResponse response = new BatchCloseResponse();
            response.setState(batchCloseState);
            response.setAttemptedDateTime(mAttemptedDateTime);
            response.setBatch(mBatch);
            response.setBatchReport(mBatchReport);
            response.setBatchReportDetailed(mBatchReportDetailed);
            response.setBatchTransfers(mBatchTransfers);
            mCallbacks.onBatchCloseStateChanged(response);
        }
    }

    /**
     * Update tender additional info after receiving response from terminal.
     * @param tender - Finalized tender.
     * @param response - Terminal response.
     */
    private void updateTenderAdditionalInfo(@NonNull TxDbTender tender,
            @NonNull PaymentTerminalResponse response) {
        if (!TextUtils.isEmpty(response.getTerminalBatchId())) {
            tender.getAdditionalInfo().setTerminalBatchId(response.getTerminalBatchId());
        }

        if (!TextUtils.isEmpty(response.getTerminalTenderId())) {
            tender.getAdditionalInfo().setTerminalTenderId(response.getTerminalTenderId());
        }

        if (!TextUtils.isEmpty(response.getTerminalTenderSafId())) {
            tender.getAdditionalInfo().setTerminalTenderSafId(response.getTerminalTenderSafId());
        }

        if (!TextUtils.isEmpty(response.getGatewayIdentifier())) {
            tender.getAdditionalInfo().setGatewayIdentifier(response.getGatewayIdentifier());
        }

        if (!TextUtils.isEmpty(response.getGatewayGroupIdentifier())) {
            tender.getAdditionalInfo()
                    .setGatewayGroupIdentifier(response.getGatewayGroupIdentifier());
        }

        if (response.getGatewayAuthDateTime() != null) {
            tender.getAdditionalInfo().setGatewayAuthDateTime(response.getGatewayAuthDateTime());
        }

        if (!TextUtils.isEmpty(response.getGatewayAuthResponse())) {
            tender.getAdditionalInfo().setGatewayAuthResponse(response.getGatewayAuthResponse());
        }

        if (response.getSwiperType() != null) {
            tender.getAdditionalInfo().setSwiperType(response.getSwiperType());
        }

        if (!TextUtils.isEmpty(response.getTerminalTenderData())) {
            tender.getAdditionalInfo().setTerminalTenderData(response.getTerminalTenderData());
        }

        if (!TextUtils.isEmpty(response.getGatewayAuthCode())) {
            tender.setAuthCode(response.getGatewayAuthCode());
        }
    }

    /**
     * Once the tender is finalized, update it in the Transaction table.
     * @param tender - Finalized tender.
     */
    private void completeFinalizeTenderActions(@NonNull TxDbTender tender) {
        Date dateTime = new Date();
        getTransactionsDao().updateTender(
                tender.getTransactionNumber(),
                tender.getTenderNumber(),
                dateTime,
                UserHelper.getUserId(),
                dateTime,
                TenderRecordStatus.Finalized,
                TenderCreditStatusType.Completed,
                tender.getAuthCode(),
                tender.getAdditionalInfo(),
                tender.getTipAmount());

        // Update Transaction Revision/User
        getTransactionsDao().updateTransaction(
                tender.getTransactionNumber(),
                dateTime,
                UserHelper.getUserId(),
                TransactionRecordStatus.ReadyToUpload);
    }

    /**
     * Entry point for dependency injection in classes not supported by Hilt.
     */
    @EntryPoint
    @InstallIn(SingletonComponent.class)
    public interface BatchCloseManagerEntryPoint {
        BatchReportDetailedUseCase getBatchReportDetailedUseCase();
        BatchManager getBatchManager();
    }
}
