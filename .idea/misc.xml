package com.imobile3.pos.data.module.batch.close

import android.annotation.SuppressLint
import android.app.AlarmManager
import android.app.PendingIntent
import android.content.Context
import android.content.Intent
import android.os.Build
import com.imobile3.pos.app.DateHelper

import com.imobile3.pos.app.IntentHelper
import com.imobile3.pos.app.constants.IntentExtras
import com.imobile3.pos.library.utils.LogHelper
import java.text.DateFormat
import java.util.Locale

/**
 * Helper class to Schedule Alarm manager for auto batch close.
 * Alarm will be scheduled when app is in background and alarm
 * will be cancelled when app is in foreground.
 */
object AutoBatchCloseBackgroundScheduleHelper {

    const val TAG: String = "AutoBatchCloseBackgroundScheduleHelper"

    private const val PENDING_INTENT_REQUEST_CODE: Int = 1001

    @SuppressLint("UnspecifiedImmutableFlag", "ObsoleteSdkInt")
    @JvmStatic
    fun setAutoBatchAlarm(context: Context) {
        val autoBatchScheduledTime = AutoBatchHelper.getAlarmTriggerTimeInMillis()
        if (autoBatchScheduledTime <= 0) {
            return
        }

        val alarmManager = context.getSystemService(Context.ALARM_SERVICE) as AlarmManager
        val alarmIntent = Intent(context, AutoBatchAlarmReceiver::class.java)
        alarmIntent.putExtra(IntentExtras.AUTO_BATCH_CLOSE_TRIGGER, true)

        val pendingIntent = PendingIntent.getBroadcast(context,
                PENDING_INTENT_REQUEST_CODE, alarmIntent, IntentHelper.getIntentFlagForSApi())

        // API 23 and above required setExactAndAllowWhileIdle to trigger alarm in doze mode.
        if (Build.VERSION.SDK_INT >= 23) {
            alarmManager.setExactAndAllowWhileIdle(AlarmManager.RTC_WAKEUP,
                    autoBatchScheduledTime, pendingIntent)
        } else if (Build.VERSION.SDK_INT >= 19) {
            alarmManager.setExact(AlarmManager.RTC_WAKEUP, autoBatchScheduledTime, pendingIntent)
        }

        if (LogHelper.isEnabled()) {
            val dateHelper = DateHelper.getInstance(Locale.US)
            val logTime =
                dateHelper.format(autoBatchScheduledTime, DateFormat.SHORT, DateFormat.SHORT)

            // Log example: "Auto batch close alarm scheduled for 6/23/24 11:50 PM".
            LogHelper.write(TAG, "Auto batch close alarm scheduled for $logTime")
        }
    }

    @SuppressLint("UnspecifiedImmutableFlag")
    @JvmStatic
    fun cancelAutoBatchAlarm(context: Context) {
        val alarmIntent = Intent(context, AutoBatchAlarmReceiver::class.java)
        val pendingIntent = PendingIntent.getBroadcast(context,
                PENDING_INTENT_REQUEST_CODE, alarmIntent, IntentHelper.getIntentFlagForSApi())
        val alarmManager = context.getSystemService(Context.ALARM_SERVICE) as AlarmManager
        alarmManager.cancel(pendingIntent)
    }
}
