    const val COLUMN_ITEMS_REVISIONDATETIME = "REVISIONDATETIME"
    const val COLUMN_ITEMS_REVISIONUSERID = "REVISIONUSERID"
    const val COLUMN_ITEMS_QUANTITY = "QUANTITY"

    @Deprecated(
        message = "since Transaction DB version 91. Use COLUMN_ITEMS_METADATA instead.",
        replaceWith = ReplaceWith(
            expression = "COLUMN_ITEMS_METADATA",
            imports = [
                "com.imobile3.pos.library.database.table.ItemsTable.COLUMN_ITEMS_METADATA"
            ]
        ),
        level = DeprecationLevel.WARNING
    )
    const val COLUMN_ITEMS_ISALLOWPARTIAL = "ISALLOWPARTIAL"

    const val COLUMN_ITEMS_REFUNDEDQUANTITY = "REFUNDEDQUANTITY"
    const val COLUMN_ITEMS_INVENTORYID = "INVENTORYID"
    const val COLUMN_ITEMS_CATEGORYID = "CATEGORYID"
    const val COLUMN_ITEMS_CATEGORYNAME = "CATEGORYNAME"
