                db.execSQL("DROP TABLE IF EXISTS " + TransactionDb.TABLE_TRANSACTIONNOTES);
                db.execSQL("DROP TABLE IF EXISTS " + TransactionDb.TABLE_DISCOUNTITEMASSNS);
                db.execSQL("DROP TABLE IF EXISTS " + TransactionDb.TABLE_DISCOUNTS);
                db.execSQL("DROP TABLE IF EXISTS " + TransactionDb.TABLE_TAXITEMASSNS);
                db.execSQL("DROP TABLE IF EXISTS " + TransactionDb.TABLE_TAXES);
                db.execSQL("DROP TABLE IF EXISTS " + TransactionDb.TABLE_MODIFIERS);
                db.execSQL("DROP TABLE IF EXISTS " + ItemsTable.getName());
                db.execSQL("DROP TABLE IF EXISTS " + TransactionDb.TABLE_TRANSACTIONS);
                db.execSQL("DROP TABLE IF EXISTS " + TransactionDb.TABLE_BATCHTRANSFERS);
                db.execSQL("DROP TABLE IF EXISTS " + TransactionDb.TABLE_BATCHNOTES);
                db.execSQL("DROP TABLE IF EXISTS " + TransactionDb.TABLE_BATCHES);
