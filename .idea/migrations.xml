    // Code analyzer is flagging the "replace" and "else" keywords as errors.
    // The syntax errors are generated by the injected SQL parser for Android Studio
    // (instead of Lint). Ref: https://issuetracker.google.com/issues/68403417
    @SuppressWarnings("SpellCheckingInspection")
    private void migrateCategoryIdFromAdditionalInfoJson(SQLiteDatabase db) {
        // Note: The INSTR() function was added in sqlite version 3.7.15
        // Ref: https://www.sqlite.org/changes.html
        /*
        UPDATE ITEMS
        -- Update the 'Items.CategoryId' column with the JSON 'CategoryId' values
        SET CATEGORYID = (
            SELECT (
                -- Subquery: Parse the AdditionalInfo JSON column
                -- If the AdditionalInfo is null, the 'CategoryId' will be 0
                CASE WHEN I.ADDITIONALINFO IS NOT NULL
                    AND INSTR(I.ADDITIONALINFO, '"CategoryId":') != 0
                THEN SUBSTR(
                    REPLACE(I.ADDITIONALINFO, '{"CategoryId":', ''),
                    -- Start Index (first numeric digit)
                    1,
                    -- End Index (digit before the comma)
                    INSTR(REPLACE(I.ADDITIONALINFO, '{"CategoryId":', ''), ',') - 1)
                ELSE '0'
                END
            )
            FROM ITEMS as I
            -- 'Join' the subquery result to the outer update query on self.PrimaryKey
            WHERE ITEMS.ITEMNUMBER = I.ITEMNUMBER
        )
         */
        //@formatter:off
        String sql =
                "UPDATE ITEMS " +
                "SET CATEGORYID = ( " +
                "    SELECT ( " +
                "        CASE WHEN I.ADDITIONALINFO IS NOT NULL " +
                "            AND INSTR(I.ADDITIONALINFO, '\"CategoryId\":') != 0 " +
                "        THEN SUBSTR( " +
                "            REPLACE(I.ADDITIONALINFO, '{\"CategoryId\":', ''), " +
                "            1, " +
                "            INSTR(REPLACE(I.ADDITIONALINFO, '{\"CategoryId\":', ''), ',') - 1) " +
                "        ELSE '0' " +
                "        END " +
                "    ) " +
                "    FROM ITEMS AS I " +
                "    WHERE ITEMS.ITEMNUMBER = I.ITEMNUMBER " +
                ");";
        //@formatter:on
        // Collapse all extra whitespace into one space (this helps
        // clean up SQLException stack traces)
        sql = sql.trim().replaceAll(" +", " ");
        try {
            db.execSQL(sql);
        } catch (SQLException e) {
            LogHelper.write(TAG, e);
        }
    }

    /**
     * Transactions that originate from server do not send the CategoryName in the Item's
     * AdditionalInfo field which is why a migration is necessary. This new method will
     * migrate the CategoryName found in the {@link TransactionDb#COLUMN_ITEMS_ADDITIONALINFO}
     * column which is a JSON string and save it to {@link TransactionDb#COLUMN_ITEMS_CATEGORYNAME}.
     */
    @SuppressWarnings("SpellCheckingInspection")
    private void migrateCategoryNameFromAdditionalInfoJson(SQLiteDatabase db) {
        String sql = TransactionDbHelperUtils.setItemsCategoryNameFromAdditionalInfo();
        try {
            db.execSQL(sql);
        } catch (SQLException e) {
            LogHelper.write(TAG, e);
        }
    }
