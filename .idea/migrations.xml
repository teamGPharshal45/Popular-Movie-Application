    @Override
    public void onUpgrade(SQLiteDatabase db, int oldVersion, int newVersion) {
        LogHelper.write(TAG, "Upgrading database from version " + oldVersion + " to " + newVersion);

        if (oldVersion < 54) {
            // this is the first update to 6.15+, full reset required
            db.execSQL("DROP TABLE IF EXISTS STATIONITEMS");
            db.execSQL("DROP TABLE IF EXISTS STATIONTRANSACTIONS");
            db.execSQL("DROP TABLE IF EXISTS TENDERS");
            db.execSQL("DROP TABLE IF EXISTS TRANSACTIONS");
            db.execSQL("DROP TABLE IF EXISTS CARTMESSAGES");
            db.execSQL("DROP TABLE IF EXISTS CARTDISCOUNTPRODUCTASSNS");
            db.execSQL("DROP TABLE IF EXISTS CARTDISCOUNTS");
            db.execSQL("DROP TABLE IF EXISTS CARTPRODUCTTAXES");
            db.execSQL("DROP TABLE IF EXISTS CARTPRODUCTMODIFIERS");
            db.execSQL("DROP TABLE IF EXISTS CARTPRODUCTS");
            db.execSQL("DROP TABLE IF EXISTS CARTLIST");
            onCreate(db);
            return;
        }

        // 1. no breaks after each case, in case user is upgrading multiple versions
        // 2. avoid using table/column constants as we don't want to lose track of history
        // ALTER reference: https://www.sqlite.org/lang_altertable.html
        switch (oldVersion) {
            case 54:
                // add QUEUEDACTIONID column to TENDERS table (nullable)
                db.execSQL("ALTER TABLE TENDERS ADD COLUMN QUEUEDACTIONID integer;");
            case 55:
                // add CUSTOMERLOYALTYID column to TRANSACTIONS table (nullable), copy existing
                // data from CUSTOMERID into it, then clear everything from CUSTOMERID
                db.execSQL("ALTER TABLE TRANSACTIONS ADD COLUMN CUSTOMERLOYALTYID integer;");
                db.execSQL("UPDATE TRANSACTIONS SET CUSTOMERLOYALTYID = CUSTOMERID;");
                db.execSQL("UPDATE TRANSACTIONS SET CUSTOMERID = NULL;");
            case 56:
                // add TENDERNAME column to TENDERS table (nullable)
                // add ISCREATEDOFFLINE column to TENDERS table (not null, default to false)
                // add ISREFUNDFROMFAILURE column to TENDERS table (nullable)
                db.execSQL("ALTER TABLE TENDERS ADD COLUMN TENDERNAME text;");
                db.execSQL(
                        "ALTER TABLE TENDERS ADD COLUMN ISCREATEDOFFLINE boolean not null DEFAULT 0;");
                db.execSQL("ALTER TABLE TENDERS ADD COLUMN ISREFUNDFROMFAILURE boolean;");
            case 57:
                // add TOTALFEES column to TRANSACTIONS table
                // add TOTALFEES column to TENDERS table
                // Add FEES table
                // add FeeTenderAssns table
                db.execSQL(
                        "ALTER TABLE TRANSACTIONS ADD COLUMN TOTALFEES text not null DEFAULT '0.00';");
                db.execSQL(
                        "ALTER TABLE TENDERS ADD COLUMN TOTALFEES text not null DEFAULT '0.00';");
                createFeesTable57(db);
                createFeeTenderAssnsTable57(db);
            case 58:
                createDiscountTenderAssnsTable58(db);
            case 59:
                db.execSQL("ALTER TABLE TRANSACTIONS ADD COLUMN CUSTOMFIELDS text;");
            case 60:
                // add CATEGORYID column to ITEMS table, copy existing
                // data from ADDITIONALINFO (attempt to parse JSON) into it
                db.execSQL(
                        "ALTER TABLE ITEMS ADD COLUMN CATEGORYID integer not null DEFAULT 0;");
                migrateCategoryIdFromAdditionalInfoJson(db);
            case 61:
                db.execSQL("ALTER TABLE FEES ADD COLUMN REFUNDEDAMOUNT text;");
            case 62:
                db.execSQL(
                        "ALTER TABLE DISCOUNTS ADD COLUMN IGNORESDISCOUNTABLEPOLICY boolean not null DEFAULT 0;");
            case 63:
                db.execSQL("ALTER TABLE TRANSACTIONS ADD COLUMN TENDERINFO text;");
            case 64:
                db.execSQL("ALTER TABLE TRANSACTIONS ADD COLUMN RECEIPTSMS text;");
                db.execSQL(
                        "ALTER TABLE TRANSACTIONS ADD COLUMN ISSENDRECEIPTSMS boolean not null DEFAULT 0;");
                db.execSQL("ALTER TABLE TRANSACTIONS ADD COLUMN RECEIPTSMSSENTDATETIME integer;");
            case 65:
                db.execSQL(
                        "ALTER TABLE TRANSACTIONS ADD COLUMN TOTALROUNDINGAMOUNT text not null DEFAULT '0.00';");
                db.execSQL(
                        "ALTER TABLE TENDERS ADD COLUMN ROUNDINGAMOUNT text not null DEFAULT '0.00';");
            case 66:
                db.execSQL("ALTER TABLE TRANSACTIONS ADD COLUMN RECEIPTLANGUAGE text;");
            case 67:
                db.execSQL("ALTER TABLE TRANSACTIONS ADD COLUMN ORDERTYPEID integer;");
            case 68:
                db.execSQL("ALTER TABLE TRANSACTIONS ADD COLUMN ACCEPTEDDATETIME integer;");
                db.execSQL("ALTER TABLE TRANSACTIONS ADD COLUMN CUSTOMERNAME text;");
                db.execSQL("ALTER TABLE TRANSACTIONS ADD COLUMN ORDERSTATUSTYPEID integer;");
            case 69:
                db.execSQL("ALTER TABLE TRANSACTIONS ADD COLUMN RECEIPTTYPE integer;");
            case 70:
                db.execSQL("ALTER TABLE TRANSACTIONS ADD COLUMN CUSTOMERPHONE text;");
            case 71:
                db.execSQL("ALTER TABLE TRANSACTIONS ADD COLUMN CUSTOMERINVOICENUMBER text;");
            case 72:
                createNotificationTable72(db);
            case 73:
                db.execSQL(
                        "ALTER TABLE NOTIFICATIONS ADD COLUMN UPLOADATTEMPTS integer not null DEFAULT 0;");
                db.execSQL("ALTER TABLE NOTIFICATIONS ADD COLUMN METADATA text;");
            case 74:
                db.execSQL("ALTER TABLE TRANSACTIONS ADD COLUMN INVOICEID integer;");
            case 75:
                db.execSQL("ALTER TABLE TRANSACTIONS ADD COLUMN INVOICECUSTOMERID integer;");
            case 76:
                createTransactionEventsTable76(db);
            case 77:
                // add CATEGORYNAME column to ITEMS table, copy existing
                // data from ADDITIONALINFO (attempt to parse JSON) into it
                db.execSQL("ALTER TABLE ITEMS ADD COLUMN CATEGORYNAME text;");
                migrateCategoryNameFromAdditionalInfoJson(db);

                db.execSQL("ALTER TABLE ITEMS ADD COLUMN SUBCATEGORYNAME text;");
                db.execSQL("ALTER TABLE ITEMS ADD COLUMN GROUPNAME text;");
                db.execSQL("ALTER TABLE ITEMS ADD COLUMN DESCRIPTION text;");
            case 78:
                db.execSQL("ALTER TABLE TAXES ADD COLUMN ISINCLUSIVE boolean not null DEFAULT 0;");
                db.execSQL("ALTER TABLE TRANSACTIONS ADD COLUMN TOTALINCLUSIVETAX text not null " +
                        "DEFAULT '0.00';");
            case 79:
                db.execSQL("ALTER TABLE TAXITEMASSNS ADD COLUMN ISINCLUSIVE boolean not null " +
                        "DEFAULT 0;");
            case 80:
                db.execSQL("ALTER TABLE ITEMS ADD COLUMN UNITOFMEASURE text;");
            case 81:
                db.execSQL("ALTER TABLE TAXES ADD COLUMN TAXTYPEID integer not null DEFAULT 0;");
                db.execSQL(
                        "ALTER TABLE TAXITEMASSNS ADD COLUMN TAXTYPEID integer not null DEFAULT 0;");
            case 82:
                db.execSQL("ALTER TABLE TRANSACTIONS ADD COLUMN CUSTOMER text;");
                db.execSQL("ALTER TABLE TRANSACTIONS ADD COLUMN POSCUSTOMERID integer;");

            case 83:
                db.execSQL(
                        "ALTER TABLE ITEMS ADD COLUMN REVENUEAMOUNT text not null DEFAULT '0.00';");
            case 84:
                db.execSQL(
                        "ALTER TABLE TRANSACTIONS ADD COLUMN ORIGINALTRANSACTIONSOURCETYPEID integer;");

            case 85:
                db.execSQL(TransactionCustomersTable.queryCreateOriginalTableIfNotExist());

            case 86:
                db.execSQL("ALTER TABLE BATCHTRANSFERS ADD COLUMN ISDELETED boolean not null " +
                        "DEFAULT 0;");

            case 87:
                db.execSQL("ALTER TABLE TRANSACTIONS ADD COLUMN APPONLYMETADATA text;");

            case 88:
                db.execSQL(TransactionJournalTable.queryCreateOriginalTableIfNotExist());

            case 89:
                db.execSQL("ALTER TABLE TRANSACTIONS ADD COLUMN ISHANDWRITTEN boolean not null " +
                        "DEFAULT 0;");
                db.execSQL("ALTER TABLE TRANSACTIONS ADD COLUMN HANDWRITTENNUMBER text;");

            case 90:
                TransactionDbUpgradeHelper.upgradeDatabaseToVersion91(db);

            case 91:
                db.execSQL("ALTER TABLE TRANSACTIONS ADD COLUMN APPOINTMENTID text;");

            case 92:
                // next update
        }
    }

    private void createFeesTable57(SQLiteDatabase db) {
        db.execSQL("CREATE TABLE FEES (" +
                "FEENUMBER integer unique not null, " +
                "PARENTFEENUMBER integer, " +
                "TRANSACTIONNUMBER integer not null, " +
                "AMOUNT text, " +
                "NAME text not null, " +
                "TYPE integer not null, " +
                "VALUETYPE integer not null, " +
                "SETAMOUNT text, " +
                "SETPERCENTAGE text, " +
                "FEESTATUS integer not null, " +
                "ISREFUNDABLE boolean not null, " +
                "FOREIGN KEY (TRANSACTIONNUMBER) " +
                "REFERENCES TRANSACTIONS (TRANSACTIONNUMBER) " +
                "ON DELETE CASCADE);");
    }

    private void createFeeTenderAssnsTable57(SQLiteDatabase db) {
        db.execSQL("CREATE TABLE FEETENDERASSNS (" +
                "FEENUMBER integer unique not null, " +
                "TENDERNUMBER integer not null, " +
                "FOREIGN KEY (TENDERNUMBER) " +
                "REFERENCES TENDERS (TENDERNUMBER) " +
                "ON DELETE CASCADE);");
    }

    private void createDiscountTenderAssnsTable58(SQLiteDatabase db) {
        db.execSQL("CREATE TABLE DISCOUNTTENDERASSNS (" +
                "TENDERDISCOUNTNUMBER integer unique not null, " +
                "PARENTTENDERDISCOUNTNUMBER integer, " +
                "DISCOUNTNUMBER integer not null, " +
                "TENDERNUMBER integer not null, " +
                "AMOUNT text, " +
                "FOREIGN KEY (DISCOUNTNUMBER) " +
                "REFERENCES DISCOUNTS (DISCOUNTNUMBER) " +
                "ON DELETE CASCADE, " +
                "FOREIGN KEY (TENDERNUMBER) " +
                "REFERENCES TENDERS (TENDERNUMBER) " +
                "ON DELETE CASCADE);");
    }

    private void createNotificationTable72(SQLiteDatabase db) {
        db.execSQL("CREATE TABLE IF NOT EXISTS NOTIFICATIONS("
                + "ROWID integer primary key, "
                + "REFERENCENUMBER integer not null, "
                + "CREATIONDATETIME integer not null, "
                + "CHANNELTYPEID integer not null, "
                + "NOTIFICATIONTYPEID integer not null, "
                + "CATEGORYID integer not null, "
                + "LANGUAGECODE text not null, "
                + "PHONE text, "
                + "EMAIL text"
                + ");");
    }

    private void createTransactionEventsTable76(SQLiteDatabase db) {
        db.execSQL("CREATE TABLE IF NOT EXISTS TRANSACTIONEVENTS("
                + "ROWID integer primary key, "
                + "TRANSACTIONNUMBER integer not null, "
                + "CREATIONDATETIME integer not null, "
                + "CATEGORYID integer not null, "
                + "EVENTTYPEID integer not null, "
                + "UPLOADATTEMPTS integer not null, "
