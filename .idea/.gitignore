    @Test
    public void testProcessRequestAgainstAvailableTerminals_ifPaymentTerminalError() {
        String friendlyMessage = "FriendlyMessage";
        String detailedMessage = "DetailedMessage";
        String logMessage = "processAction()->iM3TerminalOnError() " + "Friendly = " +
                friendlyMessage + "; Detailed = " + detailedMessage;

        // Mock maximum number of terminal
        List<SupportedHardware> maxNumberOfTerminals =
                Collections.singletonList(SupportedHardware.CodeCR950);
        when(TerminalHelper.getAvailableTerminals()).thenReturn(maxNumberOfTerminals);
        when(TerminalHelper
                .getUnconfiguredTerminal(any(Context.class), any(SupportedHardware.class),
                        any(iM3TerminalCallbacks.class))).thenReturn(mTerminal);

        mTerminalRequestProcessor
                .processRequestAgainstAvailableTerminals(mContext, mRequest, mCallbacks);

        // Set Payment Terminal error
        PaymentTerminalError paymentTerminalError = mock(PaymentTerminalError.class);
        when(paymentTerminalError.getFriendlyMessage()).thenReturn(friendlyMessage);
        when(paymentTerminalError.getDetailedMessage()).thenReturn(detailedMessage);
        when(TextUtils.isEmpty(anyString())).thenReturn(true);

        iM3TerminalCallbacks callbacks = captureTerminalCallbacks();
        callbacks.iM3TerminalOnError(paymentTerminalError);

        verifyLogHelper(logMessage);

        // Check if mIndividualTerminalRetryCount is incremented
        assertPrivateMember("mIndividualTerminalRetryCount", 1);
    }

    @Test
    public void testProcessRequestAgainstAvailableTerminals_ifTerminalErrorAndDetailedMessageIsNull() {
        String detailedMessage = "DetailedMessage";
        String logMessage = "iM3TerminalOnError:" + detailedMessage + "; RequestedAction:Auth";

        // Mock maximum number of terminal
        List<SupportedHardware> maxNumberOfTerminals =
                Collections.singletonList(SupportedHardware.CodeCR950);
        when(TerminalHelper.getAvailableTerminals()).thenReturn(maxNumberOfTerminals);
        when(TerminalHelper
                .getUnconfiguredTerminal(any(Context.class), any(SupportedHardware.class),
                        any(iM3TerminalCallbacks.class))).thenReturn(mTerminal);
        when(mRequest.getAction()).thenReturn(PaymentTerminalAction.Auth);

        mTerminalRequestProcessor
                .processRequestAgainstAvailableTerminals(mContext, mRequest, mCallbacks);

        // Set Payment Terminal error
        PaymentTerminalError paymentTerminalError = mock(PaymentTerminalError.class);
        when(paymentTerminalError.getDetailedMessage()).thenReturn(detailedMessage);
        when(TextUtils.isEmpty(anyString())).thenReturn(false);

        iM3TerminalCallbacks callbacks = captureTerminalCallbacks();
        callbacks.iM3TerminalOnError(paymentTerminalError);

        mAuditHelper.verify(() -> AuditHelper.d(mTag, AuditEvent.Generic, logMessage));

        // Check if mIndividualTerminalRetryCount is incremented
        assertPrivateMember("mIndividualTerminalRetryCount", 1);
    }

    private iM3TerminalCallbacks captureTerminalCallbacks() {
        // Create the iM3TerminalCallbacks captor
        ArgumentCaptor<iM3TerminalCallbacks> captor =
                ArgumentCaptor.forClass(iM3TerminalCallbacks.class);

        // Verify that TerminalHelper.getUnconfiguredTermina() was called with the any first, second
        // arguments and captor.capture() as the third argument, which is where the
        // iM3TerminalCallbacks object is captured
        mTerminalHelper.verify(() -> TerminalHelper.getUnconfiguredTerminal(any(Context.class),
                any(SupportedHardware.class),
                captor.capture()));

        return captor.getValue();
    }

    private void verifyHandler() {
        // Create the Runnable captor
        ArgumentCaptor<Runnable> captor = ArgumentCaptor.forClass(Runnable.class);

        Handler handler = mHandlerConstruction.constructed().get(0);
        // Verify that postDelayed was called on the mock handler instance passing captor.capture()
        // as the first argument, which is where the Runnable object is captured and anyLong() as
        // the second argument
        verify(handler).postDelayed(captor.capture(), anyLong());

        // Get the captured Runnable object
        Runnable runnable = captor.getValue();
        runnable.run();
    }

    private void verifyAuditHelper(String expectedMessage) {
        mAuditHelper.verify(() -> AuditHelper.w(mTag, AuditEvent.Generic, expectedMessage));
    }

    private void verifyLogHelper(String expectedMessage) {
        mLogHelper.verify(() -> LogHelper.write(mTag, expectedMessage));
    }

    private void assertPrivateMember(String expectedName, int expectedValue) {
        AtomicInteger actualValue =
                ReflectionHelper.getFieldValue(mTerminalRequestProcessor, expectedName);
        assertEquals(expectedValue, actualValue.get());
    }

    private Answer<String> returnArgumentsAsString() {
        return invocation -> {
            String separator = ", ";
            StringBuilder result = new StringBuilder();

            for (Object argument : invocation.getArguments()) {
                result.append(argument.toString()).append(separator);
            }

            return result.substring(0, result.length() - separator.length());
        };
    }
}

