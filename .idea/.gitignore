class BatchTotalsTest {
    private var userHelperStatic: MockedStatic<UserHelper>? = null
    private var batchHelperStatic: MockedStatic<BatchHelper>? = null
    private lateinit var mockIdManager: IdManager
    private lateinit var mockAppEntry: AppEntryPoint

    @Before
    fun setUp() {
        mockAppEntry = mock(AppEntryPoint::class.java)
        mockIdManager = mock(IdManager::class.java)
        userHelperStatic = mockStatic(UserHelper::class.java)
        batchHelperStatic = mockStatic(com.imobile3.pos.data.module.batch.BatchHelper::class.java)
        whenever(UserHelper.getUserId()).thenReturn(123)
        whenever(BatchHelper.getCurrentBatchNumber()).thenReturn(456)
    }

    @After
    fun tearDown() {
        userHelperStatic?.close()
        batchHelperStatic?.close()
    }

    @Test
    fun `populate returns batchTotal with expected sum  when correct params passed`() {
        val creditDeposit = mock(BatchDepositDto::class.java)
        whenever(creditDeposit.paymentType).thenReturn(PaymentType.CreditCard)
        whenever(creditDeposit.totalAmount).thenReturn(BigDecimal("100.00"))
        whenever(creditDeposit.amountReceived).thenReturn(BigDecimal("101.50"))

        val cashDeposit = mock(BatchDepositDto::class.java)
        whenever(cashDeposit.paymentType).thenReturn(PaymentType.Cash)
        whenever(cashDeposit.totalAmount).thenReturn(BigDecimal("50.00"))
        whenever(cashDeposit.orderAmount).thenReturn(BigDecimal("49.00"))
        whenever(cashDeposit.tipAmount).thenReturn(BigDecimal("5.00"))

        val debitDeposit = mock(BatchDepositDto::class.java)
        whenever(debitDeposit.paymentType).thenReturn(PaymentType.DebitCard)
        whenever(debitDeposit.totalAmount).thenReturn(BigDecimal("20.00"))
        whenever(debitDeposit.amountReceived).thenReturn(BigDecimal("20.00"))

        val checkDeposit = mock(BatchDepositDto::class.java)
        whenever(checkDeposit.paymentType).thenReturn(PaymentType.Check)
        whenever(checkDeposit.totalAmount).thenReturn(BigDecimal("10.00"))
        whenever(checkDeposit.amountReceived).thenReturn(BigDecimal("10.00"))

        val giftCertDeposit = mock(BatchDepositDto::class.java)
        whenever(giftCertDeposit.paymentType).thenReturn(PaymentType.GiftCertificate)
        whenever(giftCertDeposit.totalAmount).thenReturn(BigDecimal("5.00"))
        whenever(giftCertDeposit.amountReceived).thenReturn(BigDecimal("4.00"))

        val giftCardDeposit = mock(BatchDepositDto::class.java)
        whenever(giftCardDeposit.paymentType).thenReturn(PaymentType.GiftCard)
        whenever(giftCardDeposit.totalAmount).thenReturn(BigDecimal("6.00"))
        whenever(giftCardDeposit.amountReceived).thenReturn(BigDecimal("6.00"))

        val customDeposit = mock(BatchDepositDto::class.java)
        whenever(customDeposit.paymentType).thenReturn(PaymentType.CustomTender)
        whenever(customDeposit.totalAmount).thenReturn(BigDecimal("2.00"))
        whenever(customDeposit.amountReceived).thenReturn(BigDecimal("1.50"))

        val ebtDeposit = mock(BatchDepositDto::class.java)
        whenever(ebtDeposit.paymentType).thenReturn(PaymentType.EbtCard)
        whenever(ebtDeposit.totalAmount).thenReturn(BigDecimal("7.00"))
        whenever(ebtDeposit.amountReceived).thenReturn(BigDecimal("7.00"))

        val safeDropTransfer = mock(TxDbBatchTransfer::class.java)
        whenever(safeDropTransfer.transferTypeId).thenReturn(TransferType.SafeDrop)
        whenever(safeDropTransfer.amount).thenReturn(BigDecimal("1000.00"))

        val cashInTransfer = mock(TxDbBatchTransfer::class.java)
        whenever(cashInTransfer.transferTypeId).thenReturn(TransferType.CashIn)
        whenever(cashInTransfer.amount).thenReturn(BigDecimal("30.00"))

        val deposits = listOf(
            creditDeposit,
            cashDeposit,
            debitDeposit,
            checkDeposit,
            giftCertDeposit,
            giftCardDeposit,
            customDeposit,
            ebtDeposit
        )
        val transfers = listOf(safeDropTransfer, cashInTransfer)
        val totals = BatchTotals.populate(deposits, transfers)

        assertTrue(totals.mNeedsCreditDeposit)
        assertTrue(totals.mNeedsCashDeposit)
        assertTrue(totals.mNeedsDebitDeposit)
        assertTrue(totals.mNeedsCheckDeposit)
        assertTrue(totals.mNeedsGiftCertificateDeposit)
        assertTrue(totals.mNeedsGiftCardDeposit)
        assertTrue(totals.mNeedsCustomTendersDeposit)
        assertTrue(totals.mNeedsEbtDeposit)

        assertEquals(BigDecimal("100.00"), totals.mCreditExpectedTotal)
        assertEquals(BigDecimal("101.50"), totals.mCreditReceivedTotal)
        assertEquals(BigDecimal("80.00"), totals.mCashExpectedTotal)
        assertEquals(BigDecimal("49.00"), totals.mCashReceivedTotal)
        assertEquals(BigDecimal("5.00"), totals.mCashTips)
        assertEquals(BigDecimal("20.00"), totals.mDebitExpectedTotal)
        assertEquals(BigDecimal("20.00"), totals.mDebitReceivedTotal)
        assertEquals(BigDecimal("10.00"), totals.mCheckExpectedTotal)
        assertEquals(BigDecimal("10.00"), totals.mCheckReceivedTotal)
        assertEquals(BigDecimal("5.00"), totals.mGiftCertificateExpectedTotal)
        assertEquals(BigDecimal("4.00"), totals.mGiftCertificateReceivedTotal)
        assertEquals(BigDecimal("6.00"), totals.mGiftCardExpectedTotal)
        assertEquals(BigDecimal("6.00"), totals.mGiftCardReceivedTotal)
        assertEquals(BigDecimal("2.00"), totals.mCustomTenderExpectedTotal)
        assertEquals(BigDecimal("1.50"), totals.mCustomTenderReceivedTotal)
        assertEquals(BigDecimal("7.00"), totals.mEbtExpectedTotal)
        assertEquals(BigDecimal("7.00"), totals.mEbtReceivedTotal)
    }

    @Test
    fun `calculateOverShortTotals computes over short when correct deposit types passed`() {
        val totals = BatchTotals()
        totals.mCreditExpectedTotal = BigDecimal("100.00")
        totals.mCreditReceivedTotal = BigDecimal("110.00")
        totals.mNeedsCreditDeposit = true

        totals.mCashExpectedTotal = BigDecimal("80.00")
        totals.mCashReceivedTotal = BigDecimal("70.00")
        totals.mNeedsCashDeposit = true

        totals.mDebitExpectedTotal = BigDecimal("20.00")
        totals.mDebitReceivedTotal = BigDecimal("25.00")
        totals.mNeedsDebitDeposit = false

        totals.calculateOverShortTotals()

        assertNotNull(totals.mCreditOverShort)
        assertEquals(BigDecimal("10.00"), totals.mCreditOverShort)

        assertNotNull(totals.mCashOverShort)
        assertEquals(BigDecimal("-10.00"), totals.mCashOverShort)

        assertNull(totals.mDebitOverShort)
    }
}


