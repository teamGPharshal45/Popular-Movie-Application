    private class ProductsRunner extends PagedBaseRunner {
        ProductsRunner(int pageSize) {
            super(pageSize);
        }

        private long getDelayMillis() {
            final long baseDelayMillis = 1000L;
            return baseDelayMillis + (getAttemptCount() * 100L);
        }

        private boolean isRetryAllowed(@NonNull Response<ProductListResponseDto> response) {
            @Nullable ProductListResponseDto dto = response.getDto();

            if (dto != null && dto.getData() == null
                    && response.getHttpStatusCode() == HttpStatusCode.OK) {
                /*
                In the event of a Socket timeout, we can sometimes still receive a 200 (OK)
                response, but the OkHttp client will partially fail to stream the response body,
                resulting in null data. This scenario should allow for a retry attempt, since
                it is most likely caused by a network issue (poor signal strength, etc).

                2023-07-21 12:56:17.583 : NetHelper  >  java.net.SocketTimeoutException: timeout
                    at okhttp3.internal.http2.Http2Stream$StreamTimeout.newTimeoutException(Http2Stream.kt:675)
                    at okhttp3.internal.http2.Http2Stream$StreamTimeout.exitAndThrowIfTimedOut(Http2Stream.kt:684)
                    at okhttp3.internal.http2.Http2Stream$FramingSource.read(Http2Stream.kt:379)
                    at okhttp3.internal.connection.Exchange$ResponseBodySource.read(Exchange.kt:276)
                    at okio.RealBufferedSource.read(RealBufferedSource.kt:39)
                    at okio.RealBufferedSource.exhausted(RealBufferedSource.kt:49)
                    at okio.InflaterSource.refill(InflaterSource.kt:112)
                    at okio.InflaterSource.readOrInflate(InflaterSource.kt:76)
                    at okio.InflaterSource.read(InflaterSource.kt:49)
                    at okio.GzipSource.read(GzipSource.kt:69)
                    at okio.Buffer.writeAll(Buffer.kt:1084)
                    at okio.RealBufferedSource.readString(RealBufferedSource.kt:95)
                    at okhttp3.ResponseBody.string(ResponseBody.kt:187)
                    at com.imobile3.pos.library.net.NetOkHttpHelper.getResponseBody(NetOkHttpHelper.kt:224)
                 */
                return true;
            }

            return response.isRetryable();
        }

        @Override
        public void run() {
            result = DataSyncResult.Error;

            ProductsDao dao = new ProductsDao(APP);

            resetPagingFilter();

            while (previousCursor != nextCursor
                    || isFirstPage) {
                if (sIsCancelled) {
                    createCancelledResult();
                    return;
                }

                incrementPageCount();

                Response<ProductListResponseDto> response = null;
                resetAttemptCount();
                while (getAttemptCount() <= MAX_ATTEMPTS) {
                    if (sIsCancelled) {
                        createCancelledResult();
                        return;
                    }

                    incrementAttemptCount();
                    markStartTime();
                    response = new Response<>(WebServices.getProductList(getAuthToken(),
                            pagingFilter));
                    markEndTime();
                    if (response.isSuccessful() && response.getDto().getData() != null) {
                        // Successful response from the Product List API.
                        break;
                    }

                    if (!isRetryAllowed(response)) {
                        // Retry is not allowed - fall through to the next sequence and
                        // assign an appropriate error message.
                        break;
                    }

                    // Pause for a moment after each Web Service failure, using a
                    // progressively longer duration (based on the number of attempts)
                    delay(getDelayMillis());
                }

                if (response != null
                        && response.isSuccessful()
                        && response.getDto().getData() != null) {
                    try {
                        if (dao.setProducts(response.getDto().getData(), isFirstPage)) {
                            addProgress(response.getDto().getData());
                            isFirstPage = false;
                        } else {
                            errorText = "ProductsDao.setProducts() failed";
                            return;
                        }
                    } catch (Exception e) {
                        LogHelper.write(TAG, e);
                        errorText = getErrorText(e);
                        return;
                    }

                    previousCursor = response.getDto().getPreviousCursor();
                    nextCursor = response.getDto().getNextCursor();

                    if (nextCursor != 0) {
                        pagingFilter.setCursor(nextCursor);
                    }
                } else if (response != null
                        && response.isSuccessful()
                        && response.getDto().getData() == null) {
                    errorText = "Response successful but no data returned";
                    return;
                } else {
                    errorText = getErrorText(response);
                    result = getUnsuccessfulResultType(response);
                    return;
                }

                // handy way to prevent day-long product syncs while debugging
                //                if (com.imobile3.pos.BuildConfig.DEBUG && getProgress() > 500) {
                //                    break;
                //                }
            }

            result = DataSyncResult.Complete;
        }
    }

    private class TagsRunner extends BaseRunner {
        @Override
        public void run() {
            result = DataSyncResult.Error;

            TagsDao dao = new TagsDao(APP);

            Response<OrderEntryTagListResponseDto> response = null;
            resetAttemptCount();
            while (getAttemptCount() <= MAX_ATTEMPTS) {
                incrementAttemptCount();
                markStartTime();
                response = new Response<>(WebServices.getTagList(getAuthToken()));
                markEndTime();
                if (response.isSuccessful()
                        || !response.isRetryable()) {
                    break;
                }
            }

            if (response != null
                    && response.isSuccessful()) {
                String bogusStartTime = "00:00:00";
                String bogusEndTime = "23:59:59";
                String bogusGlyph = "0";
                BigDecimal bogusPrice = BigDecimal.ZERO;
                GlyphType bogusGlyphType = GlyphType.Restaurant;

                // insert Manual Entry tag at beginning of list (all values required)
                OrderEntryTagResponseDto manualEntryTag = new OrderEntryTagResponseDto();
                manualEntryTag.setId(TagsDao.MANUAL_ENTRY_ID);
                manualEntryTag.setRevisionDateTime(new Date());
                manualEntryTag.setName(getString(R.string.current_order_tag_name_manual_entry));
                manualEntryTag.setOrdinal(TagsDao.MANUAL_ENTRY_ORDINAL);
                manualEntryTag.setColor(ContextCompat.getColor(APP,
                        R.color.color_purple));
                manualEntryTag.setStartTime(bogusStartTime);
                manualEntryTag.setEndTime(bogusEndTime);
                manualEntryTag.setGlyph(bogusGlyph);
                manualEntryTag.setGlyphType(bogusGlyphType);
                manualEntryTag.setPrice(bogusPrice);
                response.getDto().getTags().add(0, manualEntryTag);

                // insert Search tag at beginning of list (all values required)
                OrderEntryTagResponseDto searchTag = new OrderEntryTagResponseDto();
                searchTag.setId(TagsDao.SEARCH_ID);
                searchTag.setRevisionDateTime(new Date());
                searchTag.setName(getString(R.string.current_order_tag_name_search));
                searchTag.setOrdinal(TagsDao.SEARCH_ORDINAL);
                searchTag.setColor(ContextCompat.getColor(APP, R.color.color_amber));
                searchTag.setStartTime(bogusStartTime);
                searchTag.setEndTime(bogusEndTime);
                searchTag.setGlyph(bogusGlyph);
                searchTag.setGlyphType(bogusGlyphType);
                searchTag.setPrice(bogusPrice);
                response.getDto().getTags().add(0, searchTag);

                // insert 'Add Item Screen' tag
                // Not available in Scholastic app
                if (!FlavorHelper.isScholastic()) {
                    OrderEntryTagResponseDto addItem = new OrderEntryTagResponseDto();
                    addItem.setId(TagsDao.ADD_ITEM_SCREEN_ID);
                    addItem.setRevisionDateTime(new Date());
                    addItem.setName(getString(R.string.screen_item_add_new_screen));
                    addItem.setOrdinal(Integer.MAX_VALUE);
                    addItem.setColor(
                            ContextCompat.getColor(APP, R.color.button_action_color_default));
                    addItem.setStartTime(bogusStartTime);
                    addItem.setEndTime(bogusEndTime);
                    addItem.setGlyph(bogusGlyph);
                    addItem.setGlyphType(bogusGlyphType);
                    addItem.setPrice(bogusPrice);
                    response.getDto().getTags().add(addItem);
                }
                // write list to db
                try {
                    if (dao.setTags(response.getDto().getTags())) {
                        addProgress(response.getDto().getTags());
                        result = DataSyncResult.Complete;
                    } else {
                        errorText = "TagsDao.setTags() failed";
                    }
                } catch (Exception e) {
                    LogHelper.write(TAG, e);
                    errorText = getErrorText(e);
                }
            } else {
                errorText = getErrorText(response);
                result = getUnsuccessfulResultType(response);
            }
        }
    }

