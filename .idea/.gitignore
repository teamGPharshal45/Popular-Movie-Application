    private class ConstantsRunner extends BaseRunner {
        @Override
        public void run() {
            result = DataSyncResult.Error;

            ConstantsDao dao = new ConstantsDao(APP);

            Response<ConstantsDto> response = null;
            resetAttemptCount();
            while (getAttemptCount() <= MAX_ATTEMPTS) {
                incrementAttemptCount();
                markStartTime();
                response = new Response<>(WebServices.getConstants(getAuthToken()));
                markEndTime();
                if (response.isSuccessful()
                        || !response.isRetryable()) {
                    break;
                }
            }

            if (response != null && response.isSuccessful()) {
                try {
                    // Set Loyalty Look Up Types
                    Set<String> lookUpTypes = new HashSet<>();
                    if (response.getDto().getLoyaltyLookUpTypeList() != null) {
                        for (LoyaltyLookUpType lookUpType : response.getDto()
                                .getLoyaltyLookUpTypeList()) {
                            if (lookUpType == null) {
                                // non-existent LoyaltyLookUpType was deserialized, skip it
                                continue;
                            }
                            lookUpTypes.add(lookUpType.name());
                        }
                    }
                    synchronized (PrefHelper.LOCK) {
                        PrefHelper.set(PrefKeys.LOYALTY_LOOKUP_TYPES, lookUpTypes);
                    }

                    // Set Gateway Gift Card Capabilities
                    // Will return null if the location does NOT have gift card enabled
                    Set<String> gatewayGiftCardCapabilities = new HashSet<>();
                    if (response.getDto().getGatewayGiftCardCapabilities() != null) {
                        for (GatewayGiftCardCapabilities capability : response.getDto()
                                .getGatewayGiftCardCapabilities()) {
                            if (capability == null) {
                                // non-existent GatewayGiftCardCapabilities was deserialized, skip it
                                continue;
                            }
                            gatewayGiftCardCapabilities.add(capability.name());
                        }
                    }
                    PrefHelper.set(PrefKeys.GATEWAY_GIFT_CARD_CAPABILITIES,
                            gatewayGiftCardCapabilities);

                    // Set Tender Reason Types
                    if (response.getDto().getTenderReasonTypes() != null) {
                        TenderReasonHelper.saveTenderReasonList(
                                response.getDto().getTenderReasonTypes());
                    }

                    if (dao.setConstants(response.getDto())) {
                        List<OrderTypeDto> orderTypes = DataAccessHelper.readOrderTypes(APP);
                        InMemoryDataContainer.getInstance().setOrderTypes(orderTypes);

                        // Continue to update the response progress as the Constants class evolves
                        addProgress(response.getDto().getPrepaidCardRangeList());
                        addProgress(response.getDto().getOrderTypes());
                        result = DataSyncResult.Complete;
                    } else {
                        errorText = "ConstantsDao.setConstants() failed";
                    }
                } catch (Exception e) {
                    LogHelper.write(TAG, e);
                    errorText = getErrorText(e);
                }
            } else {
                errorText = getErrorText(response);
                result = getUnsuccessfulResultType(response);
            }
        }
    }

    /*
     * this runner is paged but requires a custom filter so we aren't extending PagedBaseRunner
     */
    private class TimeclockShiftsRunner extends BaseRunner {
        private final int mPageSize;

        TimeclockShiftsRunner(int pageSize) {
            mPageSize = pageSize;
        }

        @Override
        public void run() {
            if (!AccountConfigHelper.isTimeClockEnabled()
                    || (!mForceSync
                    && PrefHelper.get(PrefKeys.IS_TIME_CLOCK_INITIAL_SHIFTS_ACQUIRED, false))) {
                result = DataSyncResult.Complete;
                return;
            }

            // Cancel the shift uploader if it's running
            ShiftUploadHelper.cancel();

            // Clear existing DB version pref
            PrefHelper.remove(PrefKeys.TIMECLOCK_DB_VERSION);

            // for the time being don't fail sync if this runner fails, always return Complete
            // (errors will still be displayed in the provisioning report)
            result = DataSyncResult.Complete;

            ShiftsDao dao = new ShiftsDao(APP);

            List<ShiftStatusType> statusTypes = new ArrayList<>();
            statusTypes.add(ShiftStatusType.ClockedIn);
            statusTypes.add(ShiftStatusType.ClockedOut);
            statusTypes.add(ShiftStatusType.OnBreak);

            TimeClockShiftFilter filter = new TimeClockShiftFilter();
            filter.setShiftStatusTypes(statusTypes);
            filter.setPageSize(mPageSize);
            filter.setCursor(0);

            int previousCursor = 0;
            int nextCursor = 0;
            boolean isFirstPage = true;

            DateTime oldestPermitted = new DateTime().minusDays(Defaults.MAX_SHIFT_HISTORY_DAYS);

            while (previousCursor != nextCursor
                    || isFirstPage) {
                incrementPageCount();

                Response<ShiftListDto> response = null;
                resetAttemptCount();
                while (getAttemptCount() <= MAX_ATTEMPTS) {
                    incrementAttemptCount();
                    markStartTime();
                    response = new Response<>(TimeClockWebServices.getShiftList(getAuthToken(),
                            filter, true));
                    markEndTime();
                    if ((response.isSuccessful()
                            && response.getDto().getData() != null)
                            || !response.isRetryable()) {
                        break;
                    }
                }

                if (response != null
                        && response.isSuccessful()
                        && response.getDto().getData() != null) {
                    if (!response.getDto().getData().isEmpty()
                            && response.getDto().getData().get(0).getRevisionDateTime()
                            .before(oldestPermitted.toDate())) {
                        LogHelper.write(TAG, "Shift older than " + Defaults.MAX_SHIFT_HISTORY_DAYS +
                                " day threshold (" + oldestPermitted.toDate().toString() +
                                "), stopping");
                        return;
                    }
                    try {
                        List<Shift> shifts = new ArrayList<>();
                        for (ShiftDto shiftDto : response.getDto().getData()) {
                            try {
                                Shift shift = new Shift(shiftDto, ShiftRecordStatus.Available,
                                        true, false);
                                shifts.add(shift);
                            } catch (Exception e) {
                                // skip this shift but allow conversion to continue
                                LogEventHelper.saveEvent(AuditLevel.Debug, TAG,
                                        "Shift " + shiftDto.getShiftNumber() +
                                                " save failed: " + getErrorText(e));
                            }
                        }

                        dao.setShifts(shifts, isFirstPage);
                        addProgress(response.getDto().getData());
                        isFirstPage = false;
                    } catch (Exception e) {
                        LogHelper.write(TAG, e);
                        errorText = getErrorText(e);
                        return;
                    }

                    previousCursor = response.getDto().getPreviousCursor();
                    nextCursor = response.getDto().getNextCursor();

                    if (nextCursor != 0) {
                        filter.setCursor(nextCursor);
                    }
                } else if (response != null
                        && response.isSuccessful()
                        && response.getDto().getData() == null) {
                    errorText = "Response successful but no data returned";
                    return;
                } else {
                    errorText = getErrorText(response);
                    return;
                }
            }

            PrefHelper.set(PrefKeys.TIMECLOCK_DB_VERSION, TimeclockDb.VERSION);
            PrefHelper.set(PrefKeys.IS_TIME_CLOCK_INITIAL_SHIFTS_ACQUIRED, true);

            result = DataSyncResult.Complete;
        }
    }

    private class VouchersRunner extends BaseRunner {

        VouchersDao vouchersDao = new VouchersDao(APP);

        @Override
        public void run() {
            result = DataSyncResult.Error;
            Response<VoucherListResponseDto> response = null;

            resetAttemptCount();

            while (getAttemptCount() <= MAX_ATTEMPTS) {
                incrementAttemptCount();
                markStartTime();
                response = new Response<>(WebServices.voucherApi().getVouchers(
                        getAuthToken(),
                        AccountConfigHelper.getAccountId(),
                        AccountConfigHelper.getAccountLocationId()));
                markEndTime();

                if (response.isSuccessful() || !response.isRetryable()) {
                    break;
                }
            }

            if (response != null && response.isSuccessful()) {
                try {
                    List<VoucherDto> voucherDtos = new ArrayList<>();
                    for (CustomTenderFieldsDto responseDto : response.getDto().getVouchers()) {
                        voucherDtos.add(VoucherDto.from(responseDto));
                    }
                    if (vouchersDao.setVouchers(voucherDtos)) {
                        addProgress(response.getDto().getVouchers());
                        result = DataSyncResult.Complete;
                    } else {
                        errorText = "VouchersDao.setVouchers() failed";
                    }
                } catch (Exception e) {
                    LogHelper.write(TAG, e);
                    errorText = getErrorText(e);
                }
            } else {
                errorText = getErrorText(response);
                result = getUnsuccessfulResultType(response);
            }
        }
    }

    private abstract class BaseRunner implements Runnable {
        public int progress;
        public DataSyncResult result;
        public String errorText;

        private int mAttempt;
        private int mTotalAttempts;
        private int mTotalPages;
        private long mStartTime;
        private long mShortestTime;
        private long mLongestTime;

        public void addProgress(@Nullable List<? extends BaseDto> list) {
            if (list != null) {
                addProgress(list.size());
            }
        }

        public void addProgress(int size) {
            this.progress += size;
            updateProgress();
        }

        public int getProgress() {
            return this.progress;
        }

        public DataSyncResult getResult() {
            return this.result;
        }

        protected void createCancelledResult() {
            errorText = "Cancelled at retry attempt " + getAttemptCount();
            result = DataSyncResult.Cancelled;
        }

        @WorkerThread
        protected void delay(long durationMillis) {
            final String runnerClass = getClass().getSimpleName();

            try {
                LogHelper.write(Level.INFO, TAG,
                        runnerClass + " Delaying for " + durationMillis + " millis...");
                Thread.sleep(durationMillis);
            } catch (InterruptedException e) {
                LogHelper.write(Level.WARNING, TAG,
                        runnerClass + " Thread Interrupted While Sleeping!");
                // Restore the interrupted state - if our delay between API retries
                // gets interrupted, it's not the end of the world.
                Thread.currentThread().interrupt();
            }
        }

        public void resetAttemptCount() {
            if (mAttempt > 1) {
                LogHelper.write(Level.INFO, TAG,
                        getClass().getSimpleName() + " Resetting Attempt Count to Zero");
            }
            mAttempt = 0;
        }

        public void incrementAttemptCount() {
            mAttempt++;
            mTotalAttempts++;
            LogHelper.write(TAG, getClass().getSimpleName() + " Attempt #: " + mAttempt);
        }

        public void incrementPageCount() {
            mTotalPages++;
        }

        public int getAttemptCount() {
            return mAttempt;
        }

        public int getTotalAttempts() {
            return mTotalAttempts;
        }

        public int getTotalPages() {
            return mTotalPages;
        }

        public void markStartTime() {
            mStartTime = System.currentTimeMillis();
        }

        public void markEndTime() {
            calculateTimes();
        }

        public long getShortestTime() {
            return mShortestTime;
        }

        public long getLongestTime() {
            return mLongestTime;
        }

        private void calculateTimes() {
            long totalTime = System.currentTimeMillis() - mStartTime;
            if (mShortestTime == 0) {
                mShortestTime = totalTime;
            } else if (totalTime < mShortestTime) {
                mShortestTime = totalTime;
            }

            if (mLongestTime == 0) {
                mLongestTime = totalTime;
            } else if (totalTime > mLongestTime) {
                mLongestTime = totalTime;
            }
        }
    }

    private abstract class PagedBaseRunner extends BaseRunner {
        public final PagingFilter pagingFilter;
        public final int pageSize;
        public int previousCursor;
        public int nextCursor;
        boolean isFirstPage;

        public PagedBaseRunner(int pageSize) {
            this.pageSize = pageSize;
            this.pagingFilter = new PagingFilter();

            resetPagingFilter();
        }

        public void resetPagingFilter() {
            this.pagingFilter.setPageSize(pageSize);
            this.pagingFilter.setCursor(0);
            this.previousCursor = 0;
            this.nextCursor = 0;
            this.isFirstPage = true;
        }
    }

    private void updateProgress() {
        StringBuilder sb = new StringBuilder();
        sb.append(getString(R.string.dialog_progress_sync));

        int total = 0;
        for (BaseRunner runner : mRunners) {
            total += runner.getProgress();
        }
        if (total > 0) {
            sb.append(" ").append(total).append(" ").append(
                    getString(R.string.dialog_progress_sync_label_downloaded));
        }

        publishProgress(sb.toString());
    }

    /**
     * @return the total progress made by all the runners.
     */
    private int getRunnersProgress() {
        int total = 0;
        for (BaseRunner runner : mRunners) {
            total += runner.getProgress();
        }

        return total;
    }

    /**
     * Updates the total progress count.
     *
     * @param progressCount count to be added to the total sync progress.
     */
    private void updateProgress(int progressCount) {
        // Load total progress made by runners and set as starting value for use cases total progress.
        if (useCasesTotalProgress == 0) {
            useCasesTotalProgress = getRunnersProgress();
        }

        useCasesTotalProgress += progressCount;
        StringBuilder sb = new StringBuilder();
        sb.append(getString(R.string.dialog_progress_sync));

        if (useCasesTotalProgress > 0) {
            sb.append(" ").append(useCasesTotalProgress).append(" ").append(
                    getString(R.string.dialog_progress_sync_label_downloaded));
        }

        publishProgress(sb.toString());
    }

    private String getErrorText(Exception e) {
        return getErrorText(null, e);
    }

    private String getErrorText(String taskDescription, Exception e) {
        if (taskDescription != null) {
            return taskDescription + " :: " + e.toString();
        }
        return e.toString();
    }

    private <T extends BaseDto> String getErrorText(Response<T> response) {
        return getErrorText(null, response);
    }

    private <T extends BaseDto> String getErrorText(String taskDescription, Response<T> response) {
        StringBuilder sb = new StringBuilder();
        if (taskDescription != null) {
            sb.append(taskDescription);
        }
        int statusCode = response.getHttpStatusCode() != null ?
                response.getHttpStatusCode().key : Ids.UNDEFINED;
        if (statusCode != Ids.UNDEFINED) {
            if (sb.length() > 0) {
                sb.append(" :: ");
            }
            sb.append(statusCode);
        }
        if (!TextUtils.isEmpty(response.getMessage())) {
            if (sb.length() > 0) {
                sb.append(" :: ");
            }
            sb.append(response.getMessage());
        }
        if (response.isDtoNull()) {
            if (sb.length() > 0) {
                sb.append(" :: ");
            }
            sb.append("Response object null, most likely due to timeout");
        }

        return sb.toString();
    }

    private <T extends BaseDto> DataSyncResult getUnsuccessfulResultType(Response<T> response) {
        if (response != null) {
            if (response.isInvalidAuthToken()) {
                return DataSyncResult.InvalidAuthToken;
            } else if (response.isInvalidRegister()) {
                return DataSyncResult.InvalidRegister;
            } else if (response.isAccountInactive()) {
                return DataSyncResult.AccountInactive;
            } else if (response.isLocationInactive()) {
                return DataSyncResult.LocationInactive;
            }
        }
        return DataSyncResult.Error;
    }

    // post-sync alterations

    private DataSyncResult runPostSyncAlterations() {
        // cache product category colors
        if (!cacheProductCategoryExtras()) {
            return DataSyncResult.Error;
        }

        // cache tagProductAssn start/end times
        if (!cacheTagProductAssnTimes()) {
            return DataSyncResult.Error;
        }

        // perform flavor-specific alterations, if any
        if (!FlavorHelper.runPostSyncAlterations(APP)) {
            return DataSyncResult.Error;
        }

        return DataSyncResult.Complete;
    }

    private boolean cacheProductCategoryExtras() {
        try {
            ProductsDao dao = new ProductsDao(APP);
            dao.setProductsCache();
        } catch (Exception e) {
            LogHelper.write(TAG, e);
            LogHelper.write(TAG, getErrorText("cacheProductCategoryExtras", e));
            return false;
        }
        return true;
    }

    private boolean cacheTagProductAssnTimes() {
        try {
            TagProductAssnsDao dao = new TagProductAssnsDao(APP);
            dao.setTagProductAssnsCache();
        } catch (Exception e) {
            LogHelper.write(TAG, e);
            LogHelper.write(TAG, getErrorText("cacheTagProductAssnTimes", e));
            return false;
        }
        return true;
    }

    /**
     * Loads and stores data in {@link InMemoryDataContainer} in a background thread.
     */
    public static void loadInMemoryData(@NonNull final Context context) {
        if (InMemoryDataContainer.getInstance().isReady()) return;

        new Thread(() -> populateDataContainer(context)).start();
    }

    private String getString(@StringRes int resourceId) {
        return ResourceHelper.getString(resourceId);
    }

    /**
     * This function is responsible to store the terms of use & privacy policy URLs in shared
     * preference
     *
     * @param legalUrls Contains list of {@link LegalUrlsDto} which we get from server
     */
    private void saveBrandUrls(List<LegalUrlsDto> legalUrls) {
        if (legalUrls != null) {
            for (int i = 0; i < legalUrls.size(); i++) {
                LegalUrlsDto item = legalUrls.get(i);
                if (item != null && !item.getUrl().isEmpty()) {
                    if (item.getLegalUrlType() == LegalUrlType.TermsOfUse) {
                        accountConfig.setBrandTermsOfUseUrl(item.getUrl());
                    } else if (item.getLegalUrlType() == LegalUrlType.PrivacyPolicy) {
                        accountConfig.setBrandPrivacyPolicyUrl(item.getUrl());
                    }
                }
            }
        }
    }
}
