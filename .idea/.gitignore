    private class StationsRunner extends BaseRunner {
        @Override
        public void run() {
            result = DataSyncResult.Error;

            StationsDao dao = new StationsDao(APP);

            Response<StationListResponseDto> response = null;
            resetAttemptCount();
            while (getAttemptCount() <= MAX_ATTEMPTS) {
                incrementAttemptCount();
                markStartTime();
                response = new Response<>(WebServices.getStationList(getAuthToken(), mAccountId,
                        mAccountLocationId));
                markEndTime();
                if (response.isSuccessful()
                        || !response.isRetryable()) {
                    break;
                }
            }

            if (response != null
                    && response.isSuccessful()) {
                // get previous stations before overwriting for pref cleanup
                List<StationDto> previousStations = StationHelper.getStations();

                // cleanup orphaned station prefs
                if (previousStations != null) {
                    List<StationDto> newStations = StationHelper.getStations();
                    for (StationDto previousStation : previousStations) {
                        int stationId = previousStation.getId();
                        boolean matchFound = false;

                        if (newStations != null) {
                            for (StationDto newStation : newStations) {
                                if (previousStation.getId() == newStation.getId()) {
                                    matchFound = true;
                                    break;
                                }
                            }
                        }
                        if (!matchFound) {
                            PrefHelper.remove(PrinterHelper.getDeviceIdKey(stationId));
                            PrefHelper.remove(PrinterHelper.getConnectionTypeIdKey(stationId));
                            PrefHelper.remove(PrinterHelper.getAddressKey(stationId));
                        }
                    }
                }

                // transfer legacy printer prefs to new station prefs
                LegacyPrefTransferHelper.transferLegacyPrinterPrefs();

                try {
                    if (dao.setStations(response.getDto().getStationList())) {
                        addProgress(response.getDto().getStationList());
                        result = DataSyncResult.Complete;
                    } else {
                        errorText = "StationsDao.setStations() failed";
                    }
                } catch (Exception e) {
                    LogHelper.write(TAG, e);
                    errorText = getErrorText(e);
                }
            } else {
                errorText = getErrorText(response);
                result = getUnsuccessfulResultType(response);
            }
        }
    }

