import dagger.hilt.EntryPoint;
import dagger.hilt.InstallIn;
import dagger.hilt.android.EntryPointAccessors;
import dagger.hilt.components.SingletonComponent;

public class DataSyncTask extends BaseWebAsyncTask<Void, String, DataSyncResult> {

    private static final String TAG = "DataSyncTask";
    private static final MainApplication APP = MainApplication.getInstance();
    private static final int MAX_ATTEMPTS = 5;

    private static final AtomicBoolean IS_RUNNING = new AtomicBoolean(false);

    /**
     * Used when the data sync process is cancelled. The <b>IS_RUNNING</b> boolean flag may
     * still be "true" for a few milliseconds or even seconds until all IO requests are cancelled
     * and closed.
     */
    private static boolean sIsCancelled;

    private final boolean mForceSync;
    private final int mAccountId;
    private final int mAccountLocationId;

    private int mNewSyncVersion;
    private String mReceiptImageUrl;

    private List<BaseRunner> mRunners;

    /**
     * Keeps track of the overall progress while syncing use cases.
     */
    private int useCasesTotalProgress = 0;

    AccountConfig accountConfig = AppEntryPoint.get().getAccountConfig();
    AgencyFeatures agencyFeatures = AppEntryPoint.get().getAgencyFeatures();

    /**
     * Allows dependency injection in classes not supported by Hilt.
     */
    @EntryPoint
    @InstallIn(SingletonComponent.class)
    public interface DataSyncUseCasesEntryPoint {
        DataSyncUseCases getDataSyncUseCases();
        GetAddressRulesByCountryUseCase getAddressRulesByCountryUseCase();
        SeedNumberGeneratorUseCase getSeedNumberGeneratorUseCase();
    }

    private static DataSyncUseCasesEntryPoint getEntryPoint() {
        return EntryPointAccessors.fromApplication(APP, DataSyncUseCasesEntryPoint.class);
    }

    protected DataSyncTask(FragmentActivity activity, boolean forceSync) {
        super(activity);

        mForceSync = forceSync;

        mAccountId = AccountConfigHelper.getAccountId();
        mAccountLocationId = AccountConfigHelper.getAccountLocationId();
    }

    public static boolean isRunning() {
        return IS_RUNNING.get();
    }

    public static void cancel() {
        sIsCancelled = true;
    }

    /**
     * Resets the <b>DataSyncTask</b> flags to their initial state if it was cancelled.
     * The <b>Cancel</b> operation can be initiated either by the user or silently in background
     * when the host activity is destroyed.
     *
     * @return True if the DataSyncTask has been cancelled and reset.
     */
    private static boolean wasDataSyncCancelled() {
        if (sIsCancelled) {
            sIsCancelled = false;
            IS_RUNNING.set(false);
            LogHelper.write(TAG, "DataSyncTask has been cancelled and reset.");
            return true;
        }

        return false;
    }

    @Override
    protected void waitForForeground() {
        // Stop waiting and resume immediately if cancelled.
        if (sIsCancelled) return;

        super.waitForForeground();
    }

    /**
     * Callback invoked when the host activity which initiated the data sync process is destroyed.
     * The <b>DataSyncTask</b> cannot be reattached to another activity like in the scenarios of
     * configuration changes causing activity recreation when the language is changed or soft
     * keyboard is displayed on the screen. That means that the data sync process cannot continue
     * anymore and should be terminated silently in background.
     */
    @Override
    protected void onFragmentDetached() {
        super.onFragmentDetached();
        LogHelper.write(TAG,
                "DataSyncTask has been detached from the host activity and will be cancelled...");
        cancel();
    }

    @Override
    protected DataSyncResult doInBackground(Void... voids) {
        if (!IS_RUNNING.compareAndSet(false, true)) {
            return DataSyncResult.Busy;
        }

        LogHelper.write(TAG, "starting data sync task");

        // get location first
        DataSyncResult locationSyncResult = getLocation();
        if (locationSyncResult == DataSyncResult.Error
                || locationSyncResult == DataSyncResult.InvalidAuthToken
                || locationSyncResult == DataSyncResult.InvalidRegister
                || locationSyncResult == DataSyncResult.AccountInactive
                || locationSyncResult == DataSyncResult.LocationInactive) {
            waitForForeground();

            if (wasDataSyncCancelled()) return DataSyncResult.Cancelled;

            return locationSyncResult;
        }

        // full sync is not needed - check the status of our data container
        if (locationSyncResult == DataSyncResult.NotNeeded) {
            DataSyncResult dataContainerResult = DataSyncResult.NotNeeded;
            // the in-memory data container is not ready (everything else looks good)
            if (!InMemoryDataContainer.getInstance().isReady()) {
                dataContainerResult = populateDataContainer(APP);
            }
            waitForForeground();

            if (wasDataSyncCancelled()) return DataSyncResult.Cancelled;

            return dataContainerResult;
        }

        // seed number generator
        DataSyncResult seedResult = getEntryPoint().getSeedNumberGeneratorUseCase().execute();
        if (seedResult == DataSyncResult.Error
                || seedResult == DataSyncResult.InvalidAuthToken
                || seedResult == DataSyncResult.InvalidRegister
                || seedResult == DataSyncResult.AccountInactive
                || seedResult == DataSyncResult.LocationInactive) {
            waitForForeground();

            if (wasDataSyncCancelled()) return DataSyncResult.Cancelled;

            return seedResult;
        }

        // start sync threads
        DataSyncResult result = runFullSync();

        // check status before continuing
        if (result == DataSyncResult.Error
                || result == DataSyncResult.InvalidAuthToken
                || result == DataSyncResult.InvalidRegister
                || result == DataSyncResult.AccountInactive
                || result == DataSyncResult.LocationInactive) {
            waitForForeground();

            if (wasDataSyncCancelled()) return DataSyncResult.Cancelled;

            return result;
        }

        publishProgress(getString(R.string.dialog_progress_finishing_sync));

        // perform post-sync alterations
        result = runPostSyncAlterations();

        // show config DB path in logcat
        FileHelper.logDbStoragePath(ConfigDbHelper.getCurrentDbFilename(APP));

        // return result
        waitForForeground();

        if (wasDataSyncCancelled()) return DataSyncResult.Cancelled;

        return result;
    }

    @Override
    protected void onProgressUpdate(String... progress) {
        showProgressDialog(progress[0]);
    }

    @Override
    @CallSuper
    protected void onPostExecute(DataSyncResult result) {
        super.onPostExecute(result);

        if (result == DataSyncResult.NotNeeded) {
            saveMonitoringAttributes();
            LogHelper.write(TAG, "sync not needed");
        } else if (result == DataSyncResult.Complete) {
            // update db & sync version last
            PrefHelper.set(PrefKeys.SYNC_DB_VERSION, ConfigDb.VERSION);
            PrefHelper.set(PrefKeys.SYNC_VERSION, mNewSyncVersion);

            // save sync date
            RuntimeConfigHelper.setFullSyncComplete(true);
            RuntimeConfigHelper.updateLastFullSyncDateTime();

            saveMonitoringAttributes();

            LogHelper.write(TAG, "sync complete");
        } else if (result == DataSyncResult.Error) {
            LogHelper.write(TAG, "sync error");
        } else if (result == DataSyncResult.Busy) {
            LogHelper.write(TAG, "sync busy");
        } else if (result == DataSyncResult.InvalidAuthToken) {
            LogHelper.write(TAG, "sync invalid authtoken");
        } else if (result == DataSyncResult.InvalidRegister) {
            LogHelper.write(TAG, "sync invalid register");
        } else if (result == DataSyncResult.AccountInactive) {
            LogHelper.write(TAG, "sync account inactive");
        } else if (result == DataSyncResult.LocationInactive) {
            LogHelper.write(TAG, "sync location inactive");
        } else if (result == DataSyncResult.Cancelled) {
            LogHelper.write(TAG, "sync cancelled");
        } else {
            throw new IllegalStateException("SyncResult not set properly");
        }

        IS_RUNNING.set(false);
    }

    private void saveMonitoringAttributes() {
        CrashReportingHelper
                .setAttribute("AgencyID", String.valueOf(AccountConfigHelper.getAgencyId()));
        CrashReportingHelper.setAttribute("AgencyName", AccountConfigHelper.getAgencyName());
        CrashReportingHelper
                .setAttribute("AccountId", String.valueOf(AccountConfigHelper.getAccountId()));
        CrashReportingHelper.setAttribute("AccountLocationId",
                String.valueOf(AccountConfigHelper.getAccountLocationId()));
        CrashReportingHelper
                .setAttribute("RegisterId", String.valueOf(AccountConfigHelper.getRegisterId()));
        CrashReportingHelper
                .setAttribute("DeviceType", String.valueOf(AccountConfigHelper.getDeviceType()));
    }

    // Location

    private DataSyncResult getLocation() {
        AccountLocationResponseExpander expander = new AccountLocationResponseExpander();
        expander.setExpandAccount(true);
        expander.setExpandBrand(true);
        expander.setExpandOnlineOrderingLocation(true);
        expander.setExpandOrganization(true);
        expander.setExpandPaymentCardTypes(true);
        expander.setExpandPaymentTypes(true);
        expander.setExpandReceiptTypes(true);
        expander.setExpandTimeClockConfiguration(true);
        expander.setExpandSupportedHardwareIds(true);
        expander.setExpandAgencyRegisterTemplates(true);
        expander.setExpandInvoicingLocation(true);
        expander.setExpandAgency(true);
        expander.setExpandTaxInformation(true);

        Response<AccountLocationResponseDto> response = new Response<>(
                WebServices.getLocation(getAuthToken(), mAccountId, mAccountLocationId, expander));
        if (response.isSuccessful()) {
            try {
                // Update Current TOS version regardless of sync version
                PrefHelper.set(PrefKeys.CURRENT_TOS_VERSION,
                        response.getDto().getCurrentTosVersion());

                // Save Cash Rounding Type and Currency Code regardless of sync version.
                // These values are now Agency-driven and for some reasons in the original
                // implementation they were being retrieved by the Get Auth Token Request only
                // flow and in scenarios when the user attempts to upgrade the
                // app from a build which had these values hardcoded to a build with them
                // Agency-driven then when unlocking the app using PIN the Get Auth Token flow
                // was skipped and these values were lost.
                AgencyResponseDto agency = response.getDto().getAgency();
                if (agency != null) {
                    AgencyConfigHelper.saveAgencySettings(agency);
                    agencyFeatures.setFeatures(agency.getFeatures());
                }

                // Check if sync necessary
                mNewSyncVersion = response.getDto().getVersion();

                if (!mForceSync) {
                    if (PrefHelper.get(PrefKeys.SYNC_VERSION, Ids.UNDEFINED) ==
                            mNewSyncVersion) {
                        // version hasn't changed, sync not necessary
                        return DataSyncResult.NotNeeded;
                    }
                }

                AccountLocationResponseDto dto = response.getDto();

                PrefHelper.set(PrefKeys.LOCATION_NAME, dto.getName());
                PrefHelper.set(PrefKeys.LOCATION_COUNTRY, dto.getCountry());
                PrefHelper.set(PrefKeys.LOCATION_ADDRESS_STATE, dto.getState());
                PrefHelper.set(PrefKeys.LOCATION_ADDRESS_STREET, dto.getStreetAddress1());
                PrefHelper.set(PrefKeys.LOCATION_PHONE, dto.getPhone());
                PrefHelper.set(PrefKeys.RECEIPT_HEADER, dto.getReceiptHeader());
                PrefHelper.set(PrefKeys.RECEIPT_FOOTER, dto.getReceiptFooter());
                PrefHelper.set(PrefKeys.RECEIPT_SHOW_CARDHOLDER_NAME,
                        dto.isReceiptShowCardholderName());
                PrefHelper.set(PrefKeys.RECEIPT_SHOW_USER_NAME, dto.isShowUserNameOnReceipt());
                PrefHelper.set(PrefKeys.RECEIPT_SHOW_TERMINAL_IDENTIFIER,
                        dto.isShowTerminalIdentifier());
                PrefHelper.set(PrefKeys.RECEIPT_SHOW_ITEM_CODES, dto.isReceiptShowItemCode());
                PrefHelper.set(PrefKeys.RECEIPT_SHOW_TAX_TABLE, dto.isReceiptShowTaxTable());
                PrefHelper.set(PrefKeys.ALLOW_SPLIT_BALANCE, dto.isAllowSplitBalance());
                PrefHelper.set(PrefKeys.ALLOW_CUSTOMER_TO_ORDER_ASSOCIATION,
                        dto.isAllowCustomerToOrderAssociation());
                PrefHelper.set(PrefKeys.SIGN_ON_SCREEN_ALLOW, dto.isAllowSignOnScreen());
                PrefHelper.set(PrefKeys.IS_ENABLE_TRAINING_MODE, dto.isEnableTrainingMode());
                PrefHelper.set(PrefKeys.IS_ENABLE_CASH_REFUND, dto.isEnableCashRefund());
                PrefHelper.set(PrefKeys.IS_ENABLE_OPEN_REFUND, dto.isEnableOpenRefund());
                PrefHelper.set(PrefKeys.IS_ENABLE_OPEN_REFUND_AMOUNT,
                        dto.isEnableOpenRefundAmount());
                PrefHelper.set(PrefKeys.IS_ENABLE_QUICK_SALE, dto.isEnableQuickSaleMode());
                PrefHelper.set(PrefKeys.IS_HIDE_CARDHOLDER_NAME, dto.isHideCardholderName());
                PrefHelper.set(PrefKeys.IS_PAYMENT_CARD_PAYMENT_TYPE_ENABLED,
                        dto.isAllowPaymentCard());

                if (dto.getTipCalculationType() != null) {
                    PrefHelper.set(PrefKeys.TIP_CALCULATION_TYPE_ID, dto.getTipCalculationType().getKey());
                }

                // Get address rules by countryIso2Code
                // to format the Location address and save it that way
                // in the PrefKeys.RECEIPT_CONTACT_INFO
                GetAddressRulesByCountryUseCase getAddressRulesByCountryUseCase =
                        getEntryPoint().getAddressRulesByCountryUseCase();
                List<AddressFieldRule> addressRules =
                        getAddressRulesByCountryUseCase.execute(dto.getCountry());
                CustomerAddress customerAddress =
                        CustomerAddressKt.toCustomerAddress(dto, addressRules);
                AddressFormatter addressFormatter = new AddressFormatter();
                // Format address to four lines
                String contactInfo =
                        addressFormatter.formatFourLines(customerAddress, dto.getPhone());
                // Save contact info in share prefs
                PrefHelper.set(PrefKeys.RECEIPT_CONTACT_INFO, contactInfo);

                if (dto.getReceiptThreshold() != null) {
                    PrefHelper.set(PrefKeys.SIGNATURE_THRESHOLD,
                            dto.getReceiptThreshold().toString());
                } else {
                    PrefHelper.set(PrefKeys.SIGNATURE_THRESHOLD, BigDecimal.ZERO.toString());
                }
                PrefHelper.set(PrefKeys.ACCESSORY_DISPLAY_AD_URL, dto.getAdUrl());
                PrefHelper.set(PrefKeys.ACCESSORY_DISPLAY_SPLASH_URL, dto.getSplashUrl());
                if (dto.getAvsType() != null) {
                    PrefHelper.set(PrefKeys.AVS_TYPE, dto.getAvsType().key);
                } else {
                    PrefHelper.set(PrefKeys.AVS_TYPE, AvsType.None.key);
                }
                PrefHelper.set(PrefKeys.TRACK_INVENTORY, dto.isTrackInventory());
                PrefHelper.set(PrefKeys.ALLOW_SALES_WITH_NO_QOH, dto.isAllowSalesWithNoQoH());
                if (dto.getLowQuantityThreshold() != null) {
                    PrefHelper.set(PrefKeys.LOW_QUANTITY_THRESHOLD,
                            dto.getLowQuantityThreshold().toString());
                } else {
                    PrefHelper.remove(PrefKeys.LOW_QUANTITY_THRESHOLD);
                }

                // Loyalty config (sync group requires pref lock)
                synchronized (PrefHelper.LOCK) {
                    if (dto.getLoyaltyProviderType() != null) {
                        PrefHelper.set(PrefKeys.LOYALTY_PROVIDER_TYPE,
                                dto.getLoyaltyProviderType().key);
                    } else {
                        PrefHelper.set(PrefKeys.LOYALTY_PROVIDER_TYPE,
                                LoyaltyProviderType.None.key);
                    }
                    PrefHelper.set(PrefKeys.EXTERNAL_LOYALTY_MERCHANT_ID,
                            dto.getExternalLoyaltyMerchantId());
                    PrefHelper.set(PrefKeys.SHOW_LOYALTY_PROMPT_ON_CHECKOUT,
                            dto.isShowLoyaltyPromptOnCheckout());
                }

                PrefHelper.set(PrefKeys.IS_GATEWAY_ENABLED, dto.isGatewayEnabled());
                TimeClockConfigurationResponseDto timeClockConfig = dto.getTimeClockConfiguration();
                if (timeClockConfig != null && timeClockConfig.isActive()) {
                    PrefHelper.set(PrefKeys.IS_TIME_CLOCK_ENABLED, timeClockConfig.isActive());
                    PrefHelper.set(PrefKeys.TIME_CLOCK_PROMPT_FOR_CASH_TIPS,
                            timeClockConfig.isPromptForCashTips());
                    PrefHelper.set(PrefKeys.TIME_CLOCK_ALL_BREAKS_PAID,
                            timeClockConfig.isAllBreaksPaid());
                    PrefHelper.set(PrefKeys.TIME_CLOCK_PAID_BREAKS_THRESHOLD,
                            timeClockConfig.getPaidBreakThreshold());
                    PrefHelper.set(PrefKeys.TIME_CLOCK_PAY_PERIOD_TYPE,
                            timeClockConfig.getPayPeriodType().key);
                    PrefHelper.set(PrefKeys.TIME_CLOCK_ENABLE_DAILY_OVERTIME,
                            timeClockConfig.isEnableDailyOvertime());
                    PrefHelper.set(PrefKeys.TIME_CLOCK_ENABLE_WEEKLY_OVERTIME,
                            timeClockConfig.isEnableWeeklyOvertime());

                    if (timeClockConfig.getPayPeriodStartDate() != null) {
                        PrefHelper.set(PrefKeys.TIME_CLOCK_PAY_PERIOD_START_DATE,
                                timeClockConfig.getPayPeriodStartDate().getTime());
                    }

                    if (timeClockConfig.getDayOfMonthType() != null) {
                        PrefHelper.set(PrefKeys.TIME_CLOCK_PAY_PERIOD_DAY_OF_MONTH,
                                timeClockConfig.getDayOfMonthType().key);
                    }

                    if (timeClockConfig.getStartDayOfWeekType() != null) {
                        PrefHelper.set(PrefKeys.TIME_CLOCK_PAY_PERIOD_START_DAY_OF_WEEK,
                                timeClockConfig.getStartDayOfWeekType().key);
                    }

                    if (timeClockConfig.getDailyHoursBeforeOT() != null) {
                        PrefHelper.set(PrefKeys.TIME_CLOCK_DAILY_HOURS_BEFORE_OT,
                                timeClockConfig.getDailyHoursBeforeOT());
                    }

                    if (timeClockConfig.getWeeklyHoursBeforeOT() != null) {
                        PrefHelper.set(PrefKeys.TIME_CLOCK_WEEKLY_HOURS_BEFORE_OT,
                                timeClockConfig.getWeeklyHoursBeforeOT());
                    }
                } else {
                    PrefHelper.set(PrefKeys.IS_TIME_CLOCK_ENABLED, false);
                    // reset this flag so if/when timeclock is re/enabled, the latest open shifts
                    // will be acquired again:
                    PrefHelper.set(PrefKeys.IS_TIME_CLOCK_INITIAL_SHIFTS_ACQUIRED, false);
                }
                PrefHelper.set(PrefKeys.IS_ALLOW_FORCED_AUTH, dto.isAllowForcedAuth());
                if (dto.getTipMethod() != null) {
                    PrefHelper.set(PrefKeys.TIP_METHOD, dto.getTipMethod().key);
                } else {
                    PrefHelper.set(PrefKeys.TIP_METHOD, TipMethod.None.key);
                }
                PrefHelper.set(PrefKeys.IS_ALLOW_MANUAL_CARD_ENTRY, dto.isAllowManualCardEntry());

                if (dto.getTimeZone() != null) {
                    PrefHelper.set(PrefKeys.TIMEZONE_ID, dto.getTimeZone().tzId);
                } else {
                    PrefHelper.set(PrefKeys.TIMEZONE_ID, "");
                }
                DateTimeZone.setDefault(
                        DateTimeZone.forTimeZone(AccountConfigHelper.getDisplayTimeZone()));

                PrefHelper.set(PrefKeys.REQUIRE_CHECKOUT_ORDER_INFO,
                        dto.isRequiresCheckoutOrderInfo());

                if (dto.getAccount() != null) {
                    PrefHelper.set(PrefKeys.ACCOUNT_NAME, dto.getAccount().getName());

                    // AccountType
                    AccountType accountType = dto.getAccount().getAccountType();
                    if (accountType != null) {
                        PrefHelper.set(PrefKeys.ACCOUNT_TYPE, accountType.key);
                    } else {
                        PrefHelper.set(PrefKeys.ACCOUNT_TYPE, AccountType.Restaurant.key);
                    }

                    // Merchant Account Type (Standard, ProPay)
                    MerchantAccountType merchantAccountType =
                            dto.getAccount().getMerchantAccountType();
                    PrefHelper.set(PrefKeys.MERCHANT_ACCOUNT_TYPE,
                            Objects.requireNonNullElse(
                                    merchantAccountType, MerchantAccountType.Standard).getKey());

                    if (dto.getAccount().getPinTypeId() != null) {
                        PrefHelper.set(PrefKeys.PIN_TYPE, dto.getAccount().getPinTypeId().key);
                    }

                    // Transaction Custom Fields
                    PrefHelper.set(PrefKeys.IS_TRANSACTION_FIELDS_ENABLED,
                            dto.getAccount().isTransactionFieldsEnabled());
                } else {
                    // Failsafe - Default to Restaurant
                    PrefHelper.set(PrefKeys.ACCOUNT_TYPE, AccountType.Restaurant.key);
                }

                PrefHelper.set(PrefKeys.ALLOW_SCREEN_LOCK_PIN, dto.isAllowScreenLockPin());

                Set<String> paymentTypes = new HashSet<>();
                if (dto.getPaymentTypes() != null) {
                    for (PaymentType pType : dto.getPaymentTypes()) {
                        if (pType == null) {
                            // non-existent PaymentType was deserialized, skip it
                            continue;
                        }
                        paymentTypes.add(pType.name());
                    }
                }
                PrefHelper.set(PrefKeys.PAYMENT_TYPES, paymentTypes);

                Set<String> paymentCardTypes = new HashSet<>();
                if (dto.getPaymentCardTypes() != null) {
                    for (PaymentCardType pcType : dto.getPaymentCardTypes()) {
                        if (pcType == null) {
                            // non-existent PaymentCardType was deserialized, skip it
                            continue;
                        }
                        paymentCardTypes.add(pcType.name());
                    }
                }
                PrefHelper.set(PrefKeys.PAYMENT_CARD_TYPES, paymentCardTypes);

                Set<String> receiptTypes = new HashSet<>();
                if (dto.getReceiptTypes() != null) {
                    for (ReceiptType rType : dto.getReceiptTypes()) {
                        if (rType == null) {
                            // non-existent ReceiptType was deserialized, skip it
                            continue;
                        }
                        receiptTypes.add(rType.name());
                    }
                }

                if (dto.getReceiptOption() != null) {
                    PrefHelper.set(PrefKeys.RECEIPT_OPTION, dto.getReceiptOption().key);
                }

                PrefHelper.set(PrefKeys.RECEIPT_TYPES, receiptTypes);
                PrefHelper.set(PrefKeys.IS_MANUAL_TAX_FREE_ITEM_ENABLED,
                        dto.isManualTaxFreeItemEnabled());
                PrefHelper.set(PrefKeys.IS_ENABLE_ORDER_TAX_EXEMPT, dto.isEnableOrderTaxExempt());
                PrefHelper.set(PrefKeys.IS_ENABLE_PIN_LOGIN, dto.isEnablePinLogin());
                PrefHelper.set(PrefKeys.IS_DISMISS_RECEIPT, dto.isDismissReceipt());

                // Merchant Tax Information
                String serializedList = GsonHelper.getGsonForSerialization(false)
                        .toJson(dto.getMerchantTaxInformation());
                PrefHelper.set(PrefKeys.MERCHANT_TAX_INFORMATION_LIST, serializedList);

                PrefHelper.set(PrefKeys.MERCHANT_EMAIL, dto.getMerchantEmail());
                PrefHelper.set(PrefKeys.RECEIPT_SHOW_TAX_INFORMATION,
                        dto.isReceiptShowTaxInformation());
                PrefHelper.set(PrefKeys.IS_ENABLE_SALES_RECORDING_MODULE,
                        dto.isEnableSalesRecordingModule());

                // brand data
                PrefHelper.set(PrefKeys.BRAND_PORTAL_URL, dto.getBrand().getPortalUrl());
                PrefHelper.set(PrefKeys.BRAND_PORTAL_URL_SLUG, dto.getBrand().getUrlSlug());
                PrefHelper.set(PrefKeys.BRAND_SUPPORT_TYPE,
                        dto.getBrand().getBrandSupportType().key);
                PrefHelper.set(PrefKeys.BRAND_SUPPORT_URL, dto.getBrand().getSupportUrl());
                PrefHelper.set(PrefKeys.BRAND_HELP_URL, dto.getBrand().getHelpUrl());
                saveBrandUrls(dto.getBrand().getLegalUrls());
                PrefHelper.set(PrefKeys.ORGANIZATION_ID, dto.getBrand().getOrganizationId());
                PrefHelper.set(PrefKeys.BRAND_SUPPORT_PHONE_NUMBER,
                        dto.getBrand().getSupportPhoneNumber());

                // Online Ordering
                if (dto.getOnlineOrderingLocation() != null) {
                    OnlineOrderingLocationResponseDto onlineOrderingLocation =
                            dto.getOnlineOrderingLocation();
                    PrefHelper.set(PrefKeys.ONLINE_ORDERING_IS_ACTIVE, true);
                    PrefHelper.set(PrefKeys.ONLINE_ORDERING_ADD_RECEIPT_ADVERTISEMENT,
                            onlineOrderingLocation.isAddReceiptAdvertisement());
                    if (onlineOrderingLocation.getOnlineOrderingStatusType() != null) {
                        PrefHelper.set(PrefKeys.ONLINE_ORDERING_STATUS_TYPE_ID,
                                onlineOrderingLocation.getOnlineOrderingStatusType().key);
                    }
                    PrefHelper.set(PrefKeys.ONLINE_ORDERING_PICKUP_INSTRUCTIONS,
                            onlineOrderingLocation.getPickupInstructions());
                    PrefHelper.set(PrefKeys.ONLINE_ORDERING_URL, dto.getOnlineOrderingUrl());
                } else {
                    // A null location property indicates online ordering is disabled
                    // (or not active) for the account.
                    PrefHelper.set(PrefKeys.ONLINE_ORDERING_IS_ACTIVE, false);
                }

                // Order Info menu items
                accountConfig.saveBusinessInfoOptions(dto.getBusinessInfoOptions());

                // Invoice Location
                if (dto.getInvoicingLocation() != null) {
                    if (dto.getInvoicingLocation().getInvoicingLocationStatusType() != null) {
                        InvoicingLocationResponseDto invoicingLocation = dto.getInvoicingLocation();
                        PrefHelper.set(PrefKeys.INVOICING_LOCATION_STATUS_TYPE_ID,
                                invoicingLocation.getInvoicingLocationStatusType().key);
                    }
                }

                // Supported Hardware Ids
                // * Note do not clear prefs if value is null as that should be taken as an invalid
                // config.  To "unassign" all hardware, there should be an empty list.
                if (dto.getSupportedHardwareIds() != null) {
                    String serializedHardwareIds = GsonHelper.getGsonForSerialization(false)
                            .toJson(dto.getSupportedHardwareIds());
                    PrefHelper.set(PrefKeys.LOCATION_SUPPORTED_HARDWARE_IDS, serializedHardwareIds);
                } else {
                    LogHelper.write(TAG,
                            "getLocation: getSupportedHardwareIds is NULL - leaving pref as is");
                }

                if (dto.getAgencyRegisterTemplates() != null &&
                        !dto.getAgencyRegisterTemplates().isEmpty()) {
                    parseLocationAgencyTemplates(dto.getAgencyRegisterTemplates());
                } else {
                    LogHelper.write(TAG,
                            "getLocation: getAgencyRegisterTemplates is NULL or empty");
                }

                if (!TextUtils.isEmpty(dto.getCloudAmqpConnection())) {
                    boolean restartRequired = false;
                    if (!dto.getCloudAmqpConnection().equals(
                            PrefHelper.get(PrefKeys.CLOUDAMQP_CONNECTION, null, true))) {
                        // creds have changed
                        restartRequired = true;
                    } else if (FlavorHelper.isRestartRabbitMqOnSync()) {
                        // something flavor-specific requires a rabbit restart
                        restartRequired = true;
                    }

                    PrefHelper.set(PrefKeys.CLOUDAMQP_CONNECTION, dto.getCloudAmqpConnection(),
                            true);

                    if (restartRequired) {
                        SyncServiceHelper.restart(false);
                    }
                }

                mReceiptImageUrl = dto.getReceiptLogoUrl();

                /*
                 * Gift Card Information
                 */
                // Terminal Gift Card Processing
                PrefHelper.set(PrefKeys.IS_TERMINAL_GIFT_CARD_PROCESSING,
                        dto.isTerminalGiftCardProcessing());
                // Gift Card Enabled
                PrefHelper.set(PrefKeys.IS_GIFT_CARD_ENABLED, dto.isGiftCardEnabled());

                return DataSyncResult.Complete;
            } catch (Exception e) {
                LogHelper.write(TAG, e);
                LogHelper.write(TAG, getErrorText("getLocation()", e));
            }
        } else {
            LogHelper.write(TAG, getErrorText("getLocation()", response));
        }

        return getUnsuccessfulResultType(response);
    }

    private void parseLocationAgencyTemplates(
            @Nullable List<AgencyRegisterTemplateDto> agencyTemplates) {
        if (agencyTemplates != null && !agencyTemplates.isEmpty()) {
            Map<Integer, AgencyRegisterTemplateDto> agencyTemplateMap = new HashMap<>();
            for (AgencyRegisterTemplateDto template : agencyTemplates) {
                agencyTemplateMap.put(template.getRegisterTemplateId(), template);
            }
            PrefHelper.set(PrefKeys.LOCATION_SUPPORTED_TEMPLATES_MAP, agencyTemplateMap);
        }
    }

    private void parseRegisterAgencyTemplate(
            @Nullable AgencyRegisterTemplateDto registerAgencyTemplate) {
        if (registerAgencyTemplate == null) {
            LogHelper.write(TAG,
                    "RegisterRunner: AgencyRegisterTemplates is NULL , leaving prefs as is");
            return;
        }
        AgencyRegisterTemplateHelper.setRegisterSupportedTemplate(registerAgencyTemplate);
    }

    // In-Memory Data Container

    /**
     * Populates the in-memory data container only. Usually just returns
     * {@link DataSyncResult#NotNeeded} to mirror the behavior of the
     * {@link #getLocation()} method.
     */
    @WorkerThread
    private static DataSyncResult populateDataContainer(@NonNull Context context) {
        LogHelper.write(Level.FINE, TAG, "Populating in-memory data container...");

        try {
            // Order Types
            List<OrderTypeDto> orderTypes = DataAccessHelper.readOrderTypes(context);
            InMemoryDataContainer.getInstance().setOrderTypes(orderTypes);

            return DataSyncResult.NotNeeded;
        } catch (Exception e) {
            LogHelper.write(TAG, e);
            return DataSyncResult.Error;
        }
    }

    // Full Runner Set

    private DataSyncResult runFullSync() {
        // switch to other database
        switchDbFile();

        long startTime = System.currentTimeMillis();

        mRunners = new ArrayList<>();
        mRunners.add(new RegisterRunner());
        mRunners.add(new ProviderConfigRunner());
        mRunners.add(new CategoriesRunner());
        // The Products List DTO is one of our more complex (large) data models,
        // and it is common for merchants to have more products than other data
        // sets (like Taxes or Discounts), so the Products API typically requires
        // longer to stream the response body from the server; therefore, reducing
        // the page size should improve the resilience of this runner.
        mRunners.add(new ProductsRunner(600));
        mRunners.add(new TagsRunner());
        mRunners.add(new TagProductAssnsRunner(1111));
        mRunners.add(new ModifiersRunner());
        mRunners.add(new ModifierSetsRunner());
        mRunners.add(new ModifierSetAssnsRunner());
        mRunners.add(new ProductModifierSetAssnsRunner(1111));
        mRunners.add(new TaxesRunner(1111));
        mRunners.add(new ProductTaxesRunner(1111));
        mRunners.add(new DiscountsRunner());
        mRunners.add(new DiscountProductAssnsRunner(1111));
        mRunners.add(new PromotionsRunner());
        mRunners.add(new PromotionProductAssnsRunner(1111));
        mRunners.add(new SalesEventsRunner());
        mRunners.add(new SalesEventPromotionAssnsRunner(1111));
        mRunners.add(new IdentifiersRunner());
        mRunners.add(new StationsRunner());
        mRunners.add(new ProgramTypesRunner());
        mRunners.add(new MessagesRunner());
        mRunners.add(new UsersRunner());
        mRunners.add(new RolesRunner());
        mRunners.add(new CustomTendersRunner());
        mRunners.add(new CustomTransactionFieldsRunner());
        mRunners.add(new ReceiptLogoRunner(mReceiptImageUrl));
        mRunners.add(new LoyaltyProgramRunner());
        mRunners.add(new RegisterHardwareRunner());
        mRunners.add(new ConstantsRunner());
        mRunners.add(new TimeclockShiftsRunner(1111));
        mRunners.add(new VouchersRunner());

        List<Thread> threads = new ArrayList<>();

        for (BaseRunner runner : mRunners) {
            threads.add(new Thread(runner));
        }
        for (Thread thread : threads) {
            thread.start();
        }
        for (Thread thread : threads) {
            try {
                thread.join();
            } catch (InterruptedException e) {
                LogHelper.write(TAG, e);
            }
        }

        DataSyncResponse dataSyncUseCasesResponse = executeDataSyncUseCases();
        DataSyncResult syncResult = dataSyncUseCasesResponse.getDataSyncResult();

        long totalTime = System.currentTimeMillis() - startTime;
        double overallTime = totalTime / 1000.0;

        StringBuilder sb = new StringBuilder();
        sb.append("PROVISIONING REPORT:");
        sb.append(" Overall Time: ").append(overallTime).append("s").append("\n");
        for (BaseRunner runner : mRunners) {
            String name = runner.getClass().getSimpleName();
            DataSyncResult result = runner.getResult();
            int totalPages = runner.getTotalPages();
            int totalAttempts = runner.getTotalAttempts();
            double shortestTimeSec = runner.getShortestTime() / 1000.0;
            double longestTimeSec = runner.getLongestTime() / 1000.0;
            String errorText = runner.errorText;

            sb.append(name).append(": ").append(result);
            if (totalPages > 0) {
                sb.append(" / ").append("Total Pages: ").append(totalPages);
            }
            if (totalAttempts > 1) {
                int repeatAttempts = totalAttempts - 1;
                if (totalPages > 0) {
                    repeatAttempts = totalAttempts - totalPages;
                }
                if (repeatAttempts > 0) {
                    sb.append(" / ").append("REPEAT REQUESTS: ").append(repeatAttempts);
                }
            }
            if (shortestTimeSec != longestTimeSec) {
                sb.append(" / ").append("Shortest Time: ").append(shortestTimeSec).append("s");
                sb.append(" / ").append("Longest Time: ").append(longestTimeSec).append("s");
            } else {
                sb.append(" / ").append("Time: ").append(shortestTimeSec).append("s");
            }

            if (result == DataSyncResult.Error
                    || result == DataSyncResult.InvalidAuthToken
                    || result == DataSyncResult.InvalidRegister
                    || result == DataSyncResult.AccountInactive
                    || result == DataSyncResult.LocationInactive
                    || result == DataSyncResult.Cancelled) {
                if (result == DataSyncResult.Error) {
                    // invalid authtoken/register take higher priority
                    if (syncResult != DataSyncResult.InvalidAuthToken
                            && syncResult != DataSyncResult.InvalidRegister
                            && syncResult != DataSyncResult.AccountInactive
                            && syncResult != DataSyncResult.LocationInactive) {
                        syncResult = result;
                    }
                } else if (result == DataSyncResult.InvalidAuthToken) {
                    // invalid register takes higher priority
                    if (syncResult != DataSyncResult.InvalidRegister
                            && syncResult != DataSyncResult.AccountInactive
                            && syncResult != DataSyncResult.LocationInactive) {
                        syncResult = result;
                    }
                } else {
                    syncResult = result;
                }

                if (result == DataSyncResult.Cancelled) {
                    sb.append(" / ").append("INFO: ").append(errorText);
                } else {
                    sb.append(" / ").append("ERROR INFO: ").append(errorText);
                }
            }

            sb.append("\n");
        }

        // Appends the Provision Report for all use cases synced.
        sb.append(dataSyncUseCasesResponse.getProvisionReport());

        String reportText = sb.toString();

        if (syncResult != DataSyncResult.Complete) {
            // switch back to previous valid DB
            switchDbFile();

            LogEventHelper.saveEvent(AuditLevel.Debug, TAG, "Provisioning Error: " + reportText);
        } else {
            LogHelper.write(TAG, reportText);
        }

        return syncResult;
    }

    /**
     * Executes {@link DataSyncUseCases} and perform a sync on all use cases.
     */
    private DataSyncResponse executeDataSyncUseCases() {
        DataSyncUseCases dataSyncUseCases = getEntryPoint().getDataSyncUseCases();

        DataSyncPayload payload = DataSyncPayload.newInstance(mForceSync, this::updateProgress);

        return dataSyncUseCases.execute(payload);
    }

    private void switchDbFile() {
        ConfigDbHelper.setCurrentDbPrimary(APP, !ConfigDbHelper.isCurrentDbPrimary(APP));
    }

    private class RegisterRunner extends BaseRunner {
        @Override
        public void run() {
            result = DataSyncResult.Error;

            Response<RegisterResponseDto> response = null;

            RegisterExpander expander = new RegisterExpander();
            expander.setExpandAgencyRegisterTemplates(true);

            resetAttemptCount();
            while (getAttemptCount() <= MAX_ATTEMPTS) {
                incrementAttemptCount();
                markStartTime();
                response = new Response<>(WebServices.getRegister(getAuthToken(),
                        AccountConfigHelper.getRegisterId(), expander));
                markEndTime();
                if (response.isSuccessful()
                        || !response.isRetryable()) {
                    break;
                }
            }

            if (response != null
                    && response.isSuccessful()) {
                try {
                    if (response.getDto() != null) {
                        AccountConfigHelper.setRegisterName(response.getDto().getName());
                        AccountConfigHelper.setRegisterOrderNumberSeries(
                                response.getDto().getOrderNumberSeries());
                        AccountConfigHelper.setRegisterAutoBatchCloseTime(
                                response.getDto().getAutoBatchCloseTime());
                        AccountConfigHelper.setAutoBatchCloseFinalizedTendersRequired(
                                response.getDto().isAutoBatchCloseFinalizedTendersRequired());
                        AccountConfigHelper.setEnableAudibleAlerts(
                                response.getDto().isEnableAudibleAlert());
                        String defaultStartingCashAmount =
                                response.getDto().getStartingCashAmount();
                        if (defaultStartingCashAmount != null) {
                            BatchHelper.setDefaultBatchStartingCashAmount(
                                    new BigDecimal(defaultStartingCashAmount));
                        } else {
                            BatchHelper.setDefaultBatchStartingCashAmount(BigDecimal.ZERO);
                        }

                        // Agency Register Template
                        parseRegisterAgencyTemplate(response.getDto().getAgencyRegisterTemplate());
                    }
                    addProgress(1);
                    result = DataSyncResult.Complete;
                } catch (Exception e) {
                    LogHelper.write(TAG, e);
                    errorText = getErrorText(e);
                }
            } else {
                errorText = getErrorText(response);
                result = getUnsuccessfulResultType(response);
            }
        }
    }

    private class ProviderConfigRunner extends BaseRunner {
        @Override
        public void run() {
            result = DataSyncResult.Error;

            Response<ProviderConfigListResponseDto> response = null;
            resetAttemptCount();
            while (getAttemptCount() <= MAX_ATTEMPTS) {
                incrementAttemptCount();
                markStartTime();
                response = new Response<>(WebServices.providerConfigApi()
                        .getProviderConfigListSync(getAuthToken(),
                                mAccountId, mAccountLocationId,
                                AccountConfigHelper.getRegisterId()));
                markEndTime();
                if (response.isSuccessful()
                        || !response.isRetryable()) {
                    break;
                }
            }

            if (response != null
                    && response.isSuccessful()) {
                try {
                    if (response.getDto() != null
                            && response.getDto().getProviders() != null) {
                        ProviderConfigListResponseDto dto = response.getDto();

                        synchronized (PrefHelper.LOCK) {
                            ProviderConfigHelper.saveProviderConfiguration(dto);
                        }
                    }
                    addProgress(1);
                    result = DataSyncResult.Complete;
                } catch (Exception e) {
                    LogHelper.write(TAG, e);
                    errorText = getErrorText(e);
                }
            } else {
                errorText = getErrorText(response);
                result = getUnsuccessfulResultType(response);
            }
        }
    }

    private class UsersRunner extends BaseRunner {
        @Override
        public void run() {
            result = DataSyncResult.Error;

            UsersDao usersDao = new UsersDao(APP);
            UserRoleAssnsDao assnsDao = new UserRoleAssnsDao(APP);

            UserListResponseExpander expander = new UserListResponseExpander();
            expander.setExpandPermissions(true);
            expander.setExpandRoleAssns(true);
            expander.setExpandBusinessServicesPermissions(true);

            Response<UserListResponseDto> response = null;
            resetAttemptCount();
            while (getAttemptCount() <= MAX_ATTEMPTS) {
                incrementAttemptCount();
                markStartTime();
                response = new Response<>(WebServices.getUsers(getAuthToken(), expander));
                markEndTime();
                if (response.isSuccessful()
                        || !response.isRetryable()) {
                    break;
                }
            }

            if (response != null
                    && response.isSuccessful()) {
                try {
                    if (usersDao.setUsers(response.getDto().getUsers())) {
                        if (assnsDao.setUserRoleAssns(response.getDto().getUsers())) {
                            addProgress(response.getDto().getUsers());
                            result = DataSyncResult.Complete;
                        } else {
                            errorText = "UserRoleAssnsDao.setUserRoleAssns() failed";
                        }
                    } else {
                        errorText = "UsersDao.setUsers() failed";
                    }
                } catch (Exception e) {
                    LogHelper.write(TAG, e);
                    errorText = getErrorText(e);
                }
            } else {
                errorText = getErrorText(response);
                result = getUnsuccessfulResultType(response);
            }
        }
    }

    private class RolesRunner extends BaseRunner {
        @Override
        public void run() {
            result = DataSyncResult.Error;

            RolesDao dao = new RolesDao(APP);

            Response<RoleListResponseDto> response = null;
            resetAttemptCount();
            while (getAttemptCount() <= MAX_ATTEMPTS) {
                incrementAttemptCount();
                markStartTime();
                response = new Response<>(WebServices.getRoles(getAuthToken(), mAccountLocationId));
                markEndTime();
                if (response.isSuccessful()
                        || !response.isRetryable()) {
                    break;
                }
            }

            if (response != null
                    && response.isSuccessful()) {
                try {
                    if (dao.setRoles(response.getDto().getRoles())) {
                        addProgress(response.getDto().getRoles());
                        result = DataSyncResult.Complete;
                    } else {
                        errorText = "RolesDao.setRoles() failed";
                    }
                } catch (Exception e) {
                    LogHelper.write(TAG, e);
                    errorText = getErrorText(e);
                }
            } else {
                errorText = getErrorText(response);
                result = getUnsuccessfulResultType(response);
            }
        }
    }

    private class CustomTendersRunner extends BaseRunner {
        @Override
        public void run() {
