    @NonNull
    @VisibleForTesting
    public BigDecimal mCashTips;
    @NonNull
    @VisibleForTesting
    public BigDecimal mDebitExpectedTotal;
    @NonNull
    @VisibleForTesting
    public BigDecimal mDebitReceivedTotal;
    @NonNull
    @VisibleForTesting
    public BigDecimal mCheckExpectedTotal;
    @NonNull
    @VisibleForTesting
    public BigDecimal mCheckReceivedTotal;
    @NonNull
    @VisibleForTesting
    public BigDecimal mGiftCertificateExpectedTotal;
    @NonNull
    @VisibleForTesting
    public BigDecimal mGiftCertificateReceivedTotal;
    @NonNull
    @VisibleForTesting
    public BigDecimal mGiftCardExpectedTotal;
    @NonNull
    @VisibleForTesting
    public BigDecimal mGiftCardReceivedTotal;
    @NonNull
    @VisibleForTesting
    public BigDecimal mCustomTenderExpectedTotal;
    @NonNull
    @VisibleForTesting
    public BigDecimal mCustomTenderReceivedTotal;
    @NonNull
    @VisibleForTesting
    public BigDecimal mEbtExpectedTotal;
    @NonNull
    @VisibleForTesting
    public BigDecimal mEbtReceivedTotal;
    @Nullable
    @VisibleForTesting
    public BigDecimal mCreditOverShort;
    @Nullable
    @VisibleForTesting
    public BigDecimal mCashOverShort;
    @Nullable
    @VisibleForTesting
    public BigDecimal mDebitOverShort;
    @Nullable
    @VisibleForTesting
    public BigDecimal mEbtOverShort;
    @Nullable
    @VisibleForTesting
    public BigDecimal mGiftCardOverShort;
    @Nullable
    @VisibleForTesting
    public BigDecimal mGiftCertificateOverShort;
    @Nullable
    @VisibleForTesting
    public BigDecimal mCheckOverShort;
    @Nullable
    private BigDecimal mCustomTenderOverShort;

    public BatchTotals() {
        mCreditExpectedTotal = BigDecimal.ZERO;
        mCreditReceivedTotal = BigDecimal.ZERO;
        mCashExpectedTotal = BigDecimal.ZERO;
        mCashReceivedTotal = BigDecimal.ZERO;
        mCashTips = BigDecimal.ZERO;
        mDebitExpectedTotal = BigDecimal.ZERO;
        mDebitReceivedTotal = BigDecimal.ZERO;
        mCheckExpectedTotal = BigDecimal.ZERO;
        mCheckReceivedTotal = BigDecimal.ZERO;
        mGiftCertificateExpectedTotal = BigDecimal.ZERO;
        mGiftCertificateReceivedTotal = BigDecimal.ZERO;
        mGiftCardExpectedTotal = BigDecimal.ZERO;
        mGiftCardReceivedTotal = BigDecimal.ZERO;
        mCustomTenderExpectedTotal = BigDecimal.ZERO;
        mCustomTenderReceivedTotal = BigDecimal.ZERO;
        mEbtExpectedTotal = BigDecimal.ZERO;
        mEbtReceivedTotal = BigDecimal.ZERO;
    }

    public void calculateOverShortTotals() {
        if (mNeedsCreditDeposit) {
            mCreditOverShort = mCreditReceivedTotal.subtract(mCreditExpectedTotal);
        }

        if (mNeedsCashDeposit) {
            mCashOverShort = mCashReceivedTotal.subtract(mCashExpectedTotal);
        }

        if (mNeedsDebitDeposit) {
            mDebitOverShort = mDebitReceivedTotal.subtract(mDebitExpectedTotal);
        }

        if (mNeedsEbtDeposit) {
            mEbtOverShort = mEbtReceivedTotal.subtract(mEbtExpectedTotal);
        }

        if (mNeedsGiftCardDeposit) {
            mGiftCardOverShort = mGiftCardReceivedTotal.subtract(mGiftCardExpectedTotal);
        }

        if (mNeedsGiftCertificateDeposit) {
            mGiftCertificateOverShort =
                    mGiftCertificateReceivedTotal.subtract(mGiftCertificateExpectedTotal);
        }

        if (mNeedsCheckDeposit) {
            mCheckOverShort = mCheckReceivedTotal.subtract(mCheckExpectedTotal);
        }

        // TODO
        /*if (mNeedsCustomTendersDeposit) {
            for (BatchDepositDto customDeposit : mBatchReport.getCustomTenderDeposits()) {
                BigDecimal customTenderCounted, customTenderExpected, customTenderOverShort;
                for (int i = 0; i < mContainerCustomTenders.getChildCount(); i++) {
                    ViewGroup rowContainer = (ViewGroup)mContainerCustomTenders.getChildAt(i);
                    if (customDeposit.getCustomTenderFields().getCustomTenderId() ==
                            rowContainer.getTag()) {
                        customTenderCounted = rowContainer.findViewById(R.id.tender_deposit_amount);
                        customTenderExpected = rowContainer.findViewById(R.id.tender_total_amount);
                        customTenderOverShort = customTenderCounted.subtract(customTenderExpected);
                    }
                }
            }
        }*/
    }

    @NonNull
    public List<BatchDepositDto> finalizeBatchDeposits(@NonNull List<BatchDepositDto> deposits) {
        List<BatchDepositDto> finalizedDeposits = new ArrayList<>();

        IdManager idManager = AppEntryPoint.get().getIdManager();

        for (BatchDepositDto deposit : deposits) {
            if (deposit == null || deposit.getPaymentType() == null) {
                continue;
            }
            BatchDepositDto finalizedDeposit = new BatchDepositDto(deposit);
            // Set Common Data
            Date dateTime = new Date();
            finalizedDeposit.setBatchDepositNumber(idManager.getUniqueNumber());
            finalizedDeposit.setCreationDateTime(dateTime);
            finalizedDeposit.setRevisionDateTime(dateTime);
            finalizedDeposit.setCreationUserId(UserHelper.getUserId());
            finalizedDeposit.setRevisionUserId(UserHelper.getUserId());
            finalizedDeposit.setBatchNumber(BatchHelper.getCurrentBatchNumber());

            // Set Amounts
            switch (finalizedDeposit.getPaymentType()) {
                case Cash:
                    finalizedDeposit.setDepositAmount(mCashExpectedTotal.add(mCashOverShort));
                    finalizedDeposit.setOverShortAmount(mCashOverShort);
                    break;

                case CreditCard:
                    finalizedDeposit.setDepositAmount(mCreditReceivedTotal);
                    finalizedDeposit.setOverShortAmount(mCreditOverShort);
                    break;

                case Check:
                    finalizedDeposit.setDepositAmount(mCheckReceivedTotal);
                    finalizedDeposit.setOverShortAmount(mCheckOverShort);
                    break;

                case DebitCard:
                    finalizedDeposit.setDepositAmount(mDebitReceivedTotal);
                    finalizedDeposit.setOverShortAmount(mDebitOverShort);
                    break;

                case EbtCard:
                    finalizedDeposit.setDepositAmount(mEbtReceivedTotal);
                    finalizedDeposit.setOverShortAmount(mEbtOverShort);
                    break;

                case GiftCard:
                    finalizedDeposit.setDepositAmount(mGiftCardReceivedTotal);
                    finalizedDeposit.setOverShortAmount(mGiftCardOverShort);
                    break;

                case GiftCertificate:
                    finalizedDeposit.setDepositAmount(mGiftCertificateReceivedTotal);
                    finalizedDeposit.setOverShortAmount(mGiftCertificateOverShort);
                    break;

                case CustomTender:
                    finalizedDeposit.setDepositAmount(mCustomTenderReceivedTotal);
                    finalizedDeposit.setOverShortAmount(mCustomTenderOverShort);
                    break;
            }

            finalizedDeposits.add(finalizedDeposit);
        }
        return finalizedDeposits;
    }

    @NonNull
    public static BatchTotals populate(@NonNull List<BatchDepositDto> deposits,
            @NonNull List<TxDbBatchTransfer> transfers) {
        BatchTotals totals = new BatchTotals();
        for (BatchDepositDto deposit : deposits) {
            if (deposit == null || deposit.getPaymentType() == null) {
                continue;
            }
            switch (deposit.getPaymentType()) {
                case CreditCard:
                    totals.mNeedsCreditDeposit = true;

                    if (deposit.getTotalAmount() != null) {
                        totals.mCreditExpectedTotal =
                                totals.mCreditExpectedTotal.add(deposit.getTotalAmount());
                    }

                    if (deposit.getAmountReceived() != null) {
                        totals.mCreditReceivedTotal =
                                totals.mCreditReceivedTotal.add(deposit.getAmountReceived());
                    }
                    break;

                case Cash:
                    totals.mNeedsCashDeposit = true;

                    if (deposit.getTotalAmount() != null) {
                        totals.mCashExpectedTotal =
                                totals.mCashExpectedTotal.add(deposit.getTotalAmount());
                    }

                    if (deposit.getOrderAmount() != null) {
                        totals.mCashReceivedTotal = deposit.getOrderAmount();
                    }

                    if (deposit.getTipAmount() != null) {
                        totals.mCashTips = deposit.getTipAmount();
                    }

                    for (TxDbBatchTransfer transfer : transfers) {
                        if (transfer == null || transfer.getTransferTypeId() == null) {
                            continue;
                        }
                        if (!transfer.getTransferTypeId().equals(TransferType.SafeDrop)) {
                            totals.mCashExpectedTotal =
                                    totals.mCashExpectedTotal.add(transfer.getAmount());
                        }
                    }
                    break;

                case DebitCard:
                    totals.mNeedsDebitDeposit = true;

                    if (deposit.getTotalAmount() != null) {
                        totals.mDebitExpectedTotal =
                                totals.mDebitExpectedTotal.add(deposit.getTotalAmount());
                    }

                    if (deposit.getAmountReceived() != null) {
                        totals.mDebitReceivedTotal =
                                totals.mDebitReceivedTotal.add(deposit.getAmountReceived());
                    }
                    break;

                case Check:
                    totals.mNeedsCheckDeposit = true;

                    if (deposit.getTotalAmount() != null) {
                        totals.mCheckExpectedTotal =
                                totals.mCheckExpectedTotal.add(deposit.getTotalAmount());
                    }
                    if (deposit.getAmountReceived() != null) {
                        totals.mCheckReceivedTotal =
                                totals.mCheckReceivedTotal.add(deposit.getAmountReceived());
                    }
                    break;

                case GiftCertificate:
                    totals.mNeedsGiftCertificateDeposit = true;

                    if (deposit.getTotalAmount() != null) {
                        totals.mGiftCertificateExpectedTotal =
                                totals.mGiftCertificateExpectedTotal.add(deposit.getTotalAmount());
                    }
                    if (deposit.getAmountReceived() != null) {
                        totals.mGiftCertificateReceivedTotal =
                                totals.mGiftCertificateReceivedTotal
                                        .add(deposit.getAmountReceived());
                    }
                    break;

                case GiftCard:
                    totals.mNeedsGiftCardDeposit = true;

                    if (deposit.getTotalAmount() != null) {
                        totals.mGiftCardExpectedTotal =
                                totals.mGiftCardExpectedTotal.add(deposit.getTotalAmount());
                    }

                    if (deposit.getAmountReceived() != null) {
                        totals.mGiftCardReceivedTotal =
                                totals.mGiftCardReceivedTotal.add(deposit.getAmountReceived());
                    }
                    break;

                case CustomTender:
                    totals.mNeedsCustomTendersDeposit = true;

                    if (deposit.getTotalAmount() != null) {
                        totals.mCustomTenderExpectedTotal =
                                totals.mCustomTenderExpectedTotal.add(deposit.getTotalAmount());
                    }
                    if (deposit.getAmountReceived() != null) {
                        totals.mCustomTenderReceivedTotal =
                                totals.mCustomTenderReceivedTotal.add(deposit.getAmountReceived());
                    }
                    break;

                case EbtCard:
                    totals.mNeedsEbtDeposit = true;

                    if (deposit.getTotalAmount() != null) {
                        totals.mEbtExpectedTotal =
                                totals.mEbtExpectedTotal.add(deposit.getTotalAmount());
                    }

                    if (deposit.getAmountReceived() != null) {
                        totals.mEbtReceivedTotal =
                                totals.mEbtReceivedTotal.add(deposit.getAmountReceived());
                    }
                    break;

                default:
                    LogHelper.write(TAG, deposit.getPaymentType() + " Payment type not supported");
            }
        }
        return totals;
    }
}





