package com.imobile3.pos.data.datasync

import androidx.annotation.WorkerThread
import com.imobile3.pos.data.datasources.MtmConfigDataSource
import com.imobile3.pos.library.database.config.accessObjects.DemographicsDao
import com.imobile3.pos.library.database.config.accessObjects.VouchersDao
import com.imobile3.pos.library.webservices.transferobjects.invoice.CountryDto
import com.imobile3.pos.library.webservices.transferobjects.invoice.StateDto
import com.imobile3.pos.library.webservices.transferobjects.voucher.VoucherDto
import com.imobile3.pos.timeclock.database.accessObjects.ShiftsDao
import com.imobile3.pos.timeclock.domainobjects.Shift
import com.imobile3.pos.timeclock.webservices.filters.TimeClockShiftFilter
import javax.inject.Inject
import javax.inject.Singleton

open class DataSyncRepository @Inject constructor(
    private val mtmConfigDataSource: MtmConfigDataSource,
    private val shiftsDao: ShiftsDao,
    private val vouchersDao: VouchersDao,
    private val demographicsDao: DemographicsDao
) {
    @WorkerThread
    open fun getDemographics() = mtmConfigDataSource.getDemographics()

    @WorkerThread
    open fun getTimeClockShifts(filter: TimeClockShiftFilter) =
        mtmConfigDataSource.getTimeClockShifts(filter)

    @WorkerThread
    open fun insertTimeClockShifts(shifts: List<Shift>, isFirstPage: Boolean) =
        shiftsDao.setShifts(shifts, isFirstPage)

    @WorkerThread
    open fun getVouchers() = mtmConfigDataSource.getVouchers()

    @WorkerThread
    open fun insertVouchers(vouchers: List<VoucherDto>) = vouchersDao.setVouchers(vouchers)

    @WorkerThread
    open fun insertStates(states: List<StateDto>) = demographicsDao.saveStateList(states)

    @WorkerThread
    open fun insertCountries(countries: List<CountryDto>) =
        demographicsDao.saveCountryList(countries)
}
