    /**
     * Runner that fetches all of the:
     * - Taxes assigned to Products
     * - Taxes applied to Manual (Ad Hoc) items
     * - Taxes applied to Terminal Product items
     * - Taxes applied to Quick Sale items
     *
     * @see ProductTaxResponseDto
     * @see CartObjectExtensions#isAdHocItem(CartObject)
     */
    private class ProductTaxesRunner extends PagedBaseRunner {
        ProductTaxesRunner(int pageSize) {
            super(pageSize);
        }

        @Override
        public void run() {
            result = DataSyncResult.Error;

            ProductTaxesDao dao = new ProductTaxesDao(APP);

            // inventory product taxes

            resetPagingFilter();

            while (previousCursor != nextCursor
                    || isFirstPage) {
                incrementPageCount();

                Response<ProductTaxListResponseDto> response = null;
                resetAttemptCount();
                while (getAttemptCount() <= MAX_ATTEMPTS) {
                    incrementAttemptCount();
                    markStartTime();
                    response = new Response<>(
                            WebServices.getProductTaxList(getAuthToken(), pagingFilter));
                    markEndTime();
                    if ((response.isSuccessful()
                            && response.getDto().getData() != null)
                            || !response.isRetryable()) {
                        break;
                    }
                }

                if (response != null
                        && response.isSuccessful()
                        && response.getDto().getData() != null) {
                    try {
                        if (dao.setProductTaxes(response.getDto().getData(), isFirstPage)) {
                            addProgress(response.getDto().getData());
                            isFirstPage = false;
                        } else {
                            errorText = "ProductTaxesDao.setProductTaxes() (inventory) failed";
                            return;
                        }
                    } catch (Exception e) {
                        LogHelper.write(TAG, e);
                        errorText = getErrorText(e);
                        return;
                    }

                    previousCursor = response.getDto().getPreviousCursor();
                    nextCursor = response.getDto().getNextCursor();

                    if (nextCursor != 0) {
                        pagingFilter.setCursor(nextCursor);
                    }
                } else if (response != null
                        && response.isSuccessful()
                        && response.getDto().getData() == null) {
                    errorText = "Response successful but no data returned";
                    return;
                } else {
                    errorText = getErrorText(response);
                    result = getUnsuccessfulResultType(response);
                    return;
                }
            }

            // active location level product taxes

            resetPagingFilter();
            incrementPageCount();

            // set to false immediately to prevent tax table from being cleared
            isFirstPage = false;

            Response<ManualItemTaxListResponseDto> response = null;
            resetAttemptCount();
            while (getAttemptCount() <= MAX_ATTEMPTS) {
                incrementAttemptCount();
                markStartTime();
                // The 'Get Ad Hoc Item Tax List' API returns all active taxes for the
                // location (including taxes applied to Manual items, Terminal Product items,
                // and Quick Sale items).
                response = new Response<>(
                        WebServices.taxApi().getTaxesWithLocationAttributes(getAuthToken()));
                markEndTime();
                if ((response.isSuccessful()
                        && response.getDto().getLocationLevelTaxes() != null)
                        || !response.isRetryable()) {
                    break;
                }
            }

            if (response != null
                    && response.isSuccessful()
                    && response.getDto().getLocationLevelTaxes() != null) {
                try {
                    List<ProductTaxResponseDto> locationLevelTaxes =
                            response.getDto().getLocationLevelTaxes();

                    LogHelper.write(Level.FINE, TAG,
                            "Saving " + locationLevelTaxes.size() + " location level item taxes");
                    if (dao.setProductTaxes(locationLevelTaxes, false)) {
                        addProgress(locationLevelTaxes);
                        dao.updateTaxesWithLocationAttributes();
                    } else {
                        errorText = "ProductTaxesDao.setProductTaxes() (location taxes) failed";
                        return;
                    }
                } catch (Exception e) {
                    LogHelper.write(TAG, e);
                    errorText = getErrorText(e);
                    return;
                }
            } else if (response != null
                    && response.isSuccessful()
                    && response.getDto().getLocationLevelTaxes() == null) {
                errorText = "Response successful but no data returned";
                return;
            } else {
                errorText = getErrorText(response);
                result = getUnsuccessfulResultType(response);
                return;
            }

            result = DataSyncResult.Complete;
        }
    }

    private class DiscountsRunner extends BaseRunner {
        @Override
        public void run() {
            result = DataSyncResult.Error;

            DiscountsDao discountsDao = new DiscountsDao(APP);
            UsersDao usersDao = new UsersDao(APP);

            DiscountResponseExpander expander = new DiscountResponseExpander();
            expander.setExpandUsers(true);

            Response<DiscountResponseDto> response = null;
            resetAttemptCount();
            while (getAttemptCount() <= MAX_ATTEMPTS) {
                incrementAttemptCount();
                markStartTime();
                response = new Response<>(WebServices.getDiscountList(getAuthToken(), true,
                        expander));
                markEndTime();
                if (response.isSuccessful()
                        || !response.isRetryable()) {
                    break;
                }
            }

            if (response != null
                    && response.isSuccessful()) {
                try {
                    if (discountsDao.setDiscounts(response.getDto().getDiscounts())) {
                        addProgress(response.getDto().getDiscounts());
                        if (usersDao.setDiscountUserAssns(response.getDto().getDiscountUsers())) {
                            addProgress(response.getDto().getDiscountUsers());
                            result = DataSyncResult.Complete;
                        } else {
                            errorText = "UsersDao.setDiscountUserAssns() failed";
                        }
                    } else {
                        errorText = "DiscountsDao.setDiscounts() failed";
                    }
                } catch (Exception e) {
                    LogHelper.write(TAG, e);
                    errorText = getErrorText(e);
                }
            } else {
                errorText = getErrorText(response);
                result = getUnsuccessfulResultType(response);
            }
        }
    }

    private class DiscountProductAssnsRunner extends PagedBaseRunner {
        DiscountProductAssnsRunner(int pageSize) {
            super(pageSize);
        }

        @Override
        public void run() {
            result = DataSyncResult.Error;

            DiscountsDao dao = new DiscountsDao(APP);

            // discount-product assns

            resetPagingFilter();

            while (previousCursor != nextCursor
                    || isFirstPage) {
                incrementPageCount();

                Response<DiscountProductAssnListResponseDto> response = null;
                resetAttemptCount();
                while (getAttemptCount() <= MAX_ATTEMPTS) {
                    incrementAttemptCount();
                    markStartTime();
                    response = new Response<>(WebServices.getDiscountProductAssnList(getAuthToken(),
                            pagingFilter));
                    markEndTime();
                    if ((response.isSuccessful()
                            && response.getDto().getData() != null)
                            || !response.isRetryable()) {
                        break;
                    }
                }

                if (response != null
                        && response.isSuccessful()
                        && response.getDto().getData() != null) {
                    try {
                        if (dao.setDiscountProductAssns(response.getDto().getData(), isFirstPage)) {
                            addProgress(response.getDto().getData());
                            isFirstPage = false;
                        } else {
                            errorText = "DiscountsDao.setDiscountProductAssns() failed";
                            return;
                        }
                    } catch (Exception e) {
                        LogHelper.write(TAG, e);
                        errorText = getErrorText(e);
                        return;
                    }

                    previousCursor = response.getDto().getPreviousCursor();
                    nextCursor = response.getDto().getNextCursor();

                    if (nextCursor != 0) {
                        pagingFilter.setCursor(nextCursor);
                    }
                } else if (response != null
                        && response.isSuccessful()
                        && response.getDto().getData() == null) {
                    errorText = "Response successful but no data returned";
                    return;
                } else {
                    errorText = getErrorText(response);
                    result = getUnsuccessfulResultType(response);
                    return;
                }
            }

            result = DataSyncResult.Complete;
        }
    }

