                errorText = getErrorText(response);
                result = getUnsuccessfulResultType(response);
            }
        }
    }

    private class LoyaltyProgramRunner extends BaseRunner {
        @Override
        public void run() {
            result = DataSyncResult.Error;

            Response<LoyaltyProgramDto> response = null;
            resetAttemptCount();
            while (getAttemptCount() <= MAX_ATTEMPTS) {
                incrementAttemptCount();
                markStartTime();
                response = new Response<>(WebServices.getLoyaltyProgram(getAuthToken()));
                markEndTime();
                if (response.isSuccessful()
                        || !response.isRetryable()) {
                    break;
                }
            }

            if (response != null && response.isSuccessful()) {
                try {
                    LoyaltyProgramDto dto = response.getDto();

                    synchronized (PrefHelper.LOCK) {
                        PrefHelper.set(PrefKeys.LOYALTY_IS_ACTIVE, dto.isActive());
                        if (dto.isActive()) {
                            if (!TextUtils.isEmpty(dto.getProgramName())) {
                                PrefHelper.set(PrefKeys.LOYALTY_PROGRAM_NAME, dto.getProgramName());
                            }
                            if (dto.getRedemptionThreshold() != null) {
                                PrefHelper.set(PrefKeys.LOYALTY_REDEMPTION_THRESHOLD,
                                        dto.getRedemptionThreshold());
                            }
                            if (dto.getRedemptionThreshold() != null) {
                                PrefHelper.set(PrefKeys.LOYALTY_POINT_VALUE, dto.getPointValue());
                            }
                            if (dto.getVipMinTransactions() != null) {
                                PrefHelper.set(PrefKeys.LOYALTY_VIP_MIN_TRANSACTIONS,
                                        dto.getVipMinTransactions());
                            }
                            if (dto.getVipMinSpent() != null) {
                                PrefHelper
                                        .set(PrefKeys.LOYALTY_VIP_MIN_SPENT, dto.getVipMinSpent());
                            }
                            PrefHelper.set(PrefKeys.LOYALTY_PRINT_MESSAGE_ON_RECEIPT,
                                    dto.isPrintMessageOnReceipt());
                        } else {
                            PrefHelper.remove(PrefKeys.LOYALTY_PROGRAM_NAME);
                            PrefHelper.remove(PrefKeys.LOYALTY_REDEMPTION_THRESHOLD);
                            PrefHelper.remove(PrefKeys.LOYALTY_POINT_VALUE);
                            PrefHelper.remove(PrefKeys.LOYALTY_VIP_MIN_TRANSACTIONS);
                            PrefHelper.remove(PrefKeys.LOYALTY_VIP_MIN_SPENT);
                            PrefHelper.remove(PrefKeys.LOYALTY_PRINT_MESSAGE_ON_RECEIPT);
                        }
                    }

                    addProgress(1);

                    result = DataSyncResult.Complete;
                } catch (Exception e) {
                    LogHelper.write(TAG, e);
                    errorText = getErrorText(e);
                }
            } else {
                errorText = getErrorText(response);
                result = getUnsuccessfulResultType(response);
            }
        }
    }

    private class ReceiptLogoRunner extends BaseRunner {
        private final String mReceiptLogoUrl;

        ReceiptLogoRunner(String receiptLogoUrl) {
            mReceiptLogoUrl = receiptLogoUrl;
        }

        @Override
        public void run() {
            // disregard errors in this runner for now
            result = DataSyncResult.Complete;
            //    result = DataSyncResult.Error;

            String cachedUrl = PrefHelper.get(PrefKeys.RECEIPT_LOGO_URL, "");
            String receiptImageFilePath = FileHelper.getFilesDir(APP) +
                    Hardware.PRINTER_FILENAME_RECEIPTIMAGE;

            if (TextUtils.isEmpty(mReceiptImageUrl)) {
                FileHelper.deleteFile(receiptImageFilePath);
                result = DataSyncResult.Complete;
            } else {
                boolean force = mForceSync || !mReceiptImageUrl.equals(cachedUrl);

                markStartTime();
                StatusResponseDto response = WebServices.saveImage(mReceiptLogoUrl,
                        receiptImageFilePath, force);
                markEndTime();

                if (response != null) {
                    HttpStatusCode httpStatusCode = response.getHttpStatusCode();
                    if (httpStatusCode == HttpStatusCode.OK
                            || httpStatusCode == HttpStatusCode.NotModified) {
                        PrefHelper.set(PrefKeys.RECEIPT_LOGO_URL, mReceiptImageUrl);
                    } else {
                        // bad data, but just clear existing logo and proceed normally
                        FileHelper.deleteFile(receiptImageFilePath);
                    }
                    addProgress(1);
                    result = DataSyncResult.Complete;
                }
            }
        }
    }

    private class RegisterHardwareRunner extends BaseRunner {
        @Override
        public void run() {
            result = DataSyncResult.Error;

            boolean isSafeToOverwriteLocal;

            if (PrefHelper.get(PrefKeys.HARDWARE_SETTINGS_SYNCED, false)) {
                // settings have already been successfully saved to the server from this
                // installation since the feature was introduced, so it's safe to assume updating
                // from the server won't disrupt business.
                LogEventHelper.saveEvent(AuditLevel.Debug, TAG,
                        "Existing provisioned installation - overwriting local hardware settings");
                isSafeToOverwriteLocal = true;
            } else {
                boolean isPrinterDefined = PrinterHelper.getRegisterHardwareDto(
                        Hardware.PRINTER_REGISTER_STATIONID) != null;
                if (!isPrinterDefined) {
                    for (StationDto station : StationHelper.getStations()) {
                        if (PrinterHelper.getRegisterHardwareDto(station.getId()) != null) {
                            isPrinterDefined = true;
                        }
                    }
                }
                if (AccessoryDisplayHelper.getRegisterHardwareDto() != null
                        || CfdHelper.getRegisterHardwareDto() != null
                        || ScannerHelper.getRegisterHardwareDto() != null
                        || TerminalHelper.getRegisterHardwareDto() != null
                        || isPrinterDefined) {
                    // this is the first time an existing installation has performed a hardware
                    // sync since the feature was introduced, so we should update the server with
                    // the prefs already defined locally to prevent disrupting business.
                    LogEventHelper.saveEvent(AuditLevel.Debug, TAG,
                            "Existing unprovisioned installation - overwriting server hardware settings");
                    isSafeToOverwriteLocal = false;
                } else {
                    // this is a brand new installation, so we should update settings from the
                    // server in case it's setup for an out-of-box experience.
                    LogEventHelper.saveEvent(AuditLevel.Debug, TAG,
                            "New installation - overwriting local hardware settings");
                    isSafeToOverwriteLocal = true;
                }
            }

            if (isSafeToOverwriteLocal) {
                // overwrite local settings with server values
                Response<RegisterHardwareListDto> response = null;
                resetAttemptCount();
                while (getAttemptCount() <= MAX_ATTEMPTS) {
                    incrementAttemptCount();
                    markStartTime();
                    response = new Response<>(WebServices.getRegisterHardwareList(getAuthToken(),
                            AccountConfigHelper.getRegisterId()));
                    markEndTime();
                    if (response.isSuccessful()
                            || !response.isRetryable()) {
                        break;
                    }
                }

                if (response != null
                        && response.isSuccessful()) {
                    if (HardwareSettingsHelper
                            .saveHardwareList(response.getDto().getRegisterHardwareList())) {
                        PrefHelper.set(PrefKeys.HARDWARE_SETTINGS_SYNCED, true);
                        addProgress(response.getDto().getRegisterHardwareList());
                        result = DataSyncResult.Complete;
                    } else {
                        errorText = "Error saving local hardware settings";
                    }
                } else {
                    errorText = getErrorText(response);
                    result = getUnsuccessfulResultType(response);
                }
            } else {
                // send local settings to server
                RegisterHardwareListDto request = new RegisterHardwareListDto();
                request.setRegisterHardwareList(HardwareSettingsHelper.getHardwareList());

                Response<StatusResponseDto> response = null;
                resetAttemptCount();
                while (getAttemptCount() <= MAX_ATTEMPTS) {
                    incrementAttemptCount();
                    markStartTime();
                    response = new Response<>(WebServices.updateRegisterHardwareList(getAuthToken(),
                            AccountConfigHelper.getRegisterId(), request));
                    markEndTime();
                    if (response.isSuccessful()
                            || !response.isRetryable()) {
                        break;
                    }
                }

                if (response != null
                        && response.isSuccessful()) {
                    PrefHelper.set(PrefKeys.HARDWARE_SETTINGS_SYNCED, true);
                    addProgress(request.getRegisterHardwareList());
                    result = DataSyncResult.Complete;
                } else {
                    errorText = getErrorText(response);
                    result = getUnsuccessfulResultType(response);
                }
            }
        }
    }

