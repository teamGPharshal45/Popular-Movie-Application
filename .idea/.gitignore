    private class ModifierSetAssnsRunner extends BaseRunner {
        @Override
        public void run() {
            result = DataSyncResult.Error;

            ModifierSetModifierAssnsDao msmDao = new ModifierSetModifierAssnsDao(APP);
            ModifierSetProductAssnsDao mspDao = new ModifierSetProductAssnsDao(APP);

            Response<ModifierSetAllAssnResponseDto> response = null;
            resetAttemptCount();
            while (getAttemptCount() <= MAX_ATTEMPTS) {
                incrementAttemptCount();
                markStartTime();
                response = new Response<>(WebServices.getModifierSetAssnLists(getAuthToken()));
                markEndTime();
                if (response.isSuccessful()
                        || !response.isRetryable()) {
                    break;
                }
            }

            if (response != null
                    && response.isSuccessful()) {
                try {
                    boolean success1 = msmDao.setModifierSetModifierAssns(
                            response.getDto().getModifierAssns());
                    addProgress(response.getDto().getModifierAssns());

                    boolean success2 = mspDao.setModifierSetProductAssns(
                            response.getDto().getProductAssns());
                    addProgress(response.getDto().getProductAssns());

                    if (success1 && success2) {
                        result = DataSyncResult.Complete;
                    } else {
                        if (!success1) {
                            errorText =
                                    "ModifierSetModifierAssnsDao.setModifierSetModifierAssns() failed";
                        } else {
                            errorText =
                                    "ModifierSetProductAssnsDao.setModifierSetProductAssns() failed";
                        }
                    }
                } catch (Exception e) {
                    LogHelper.write(TAG, e);
                    errorText = getErrorText(e);
                }
            } else {
                errorText = getErrorText(response);
                result = getUnsuccessfulResultType(response);
            }
        }
    }

    private class ProductModifierSetAssnsRunner extends PagedBaseRunner {
        ProductModifierSetAssnsRunner(int pageSize) {
            super(pageSize);
        }

        @Override
        public void run() {
            result = DataSyncResult.Error;

            ProductModifierSetAssnsDao dao = new ProductModifierSetAssnsDao(APP);

            // get normal product-modifierset assns
            if (!getProductModifierSetAssns(dao, false)) {
                return;
            }

            // get generated (fake) product-modifierset assns
            if (!getProductModifierSetAssns(dao, true)) {
                return;
            }

            result = DataSyncResult.Complete;
        }

        private boolean getProductModifierSetAssns(ProductModifierSetAssnsDao dao,
                boolean isFakeModifierSetAssns) {
            resetPagingFilter();

            while (previousCursor != nextCursor
                    || isFirstPage) {
                incrementPageCount();

                if (isFakeModifierSetAssns) {
                    // set to false here so dao doesn't erase the non-fake assns
                    isFirstPage = false;
                }

                Response<ProductModifierSetAssnListResponseDto> response = null;
                resetAttemptCount();
                while (getAttemptCount() <= MAX_ATTEMPTS) {
                    incrementAttemptCount();
                    markStartTime();
                    response = new Response<>(WebServices.getProductModifierSetAssnList(
                            getAuthToken(), pagingFilter, isFakeModifierSetAssns));
                    markEndTime();
                    if ((response.isSuccessful()
                            && response.getDto().getData() != null)
                            || !response.isRetryable()) {
                        break;
                    }
                }

                if (response != null
                        && response.isSuccessful()
                        && response.getDto().getData() != null) {
                    try {
                        if (dao.setProductModifierSetAssns(response.getDto().getData(),
                                isFirstPage)) {
                            addProgress(response.getDto().getData());
                            isFirstPage = false;
                        } else {
                            errorText =
                                    "ProductModifierSetAssnsDao.setProductModifierSetAssns() failed";
                            return false;
                        }
                    } catch (Exception e) {
                        LogHelper.write(TAG, e);
                        errorText = getErrorText(e);
                        return false;
                    }

                    previousCursor = response.getDto().getPreviousCursor();
                    nextCursor = response.getDto().getNextCursor();

                    if (nextCursor != 0) {
                        pagingFilter.setCursor(nextCursor);
                    }
                } else if (response != null
                        && response.isSuccessful()
                        && response.getDto().getData() == null) {
                    errorText = "Response successful but no data returned";
                    return false;
                } else {
                    errorText = getErrorText(response);
                    return false;
                }
            }
            return true;
        }
    }

