    @Test
    public void testProcessRequestAgainstAvailableTerminals_ifMaxSupportedTerminalsNumberReached() {
        PaymentTerminalAction paymentTerminalAction = PaymentTerminalAction.Activate;
        String logMessage = "processAction() Too many terminals are configured; " +
                "Did you want this process to take forever? TerminalIndex = 51; Terminals.Size = 52";
        String failureMessage = String.format("%s, %s",
                R.string.terminal_request_processor_max_supported_terminal_format,
                paymentTerminalAction);

        // Mock maximum number of terminal
        List<SupportedHardware> maxNumberOfTerminals =
                new ArrayList<>(Collections.nCopies(52, SupportedHardware.CodeCR950));
        when(TerminalHelper.getAvailableTerminals()).thenReturn(maxNumberOfTerminals);

        // Mock mTerminalIndex
        AtomicInteger terminalIndex = mock(AtomicInteger.class);
        when(terminalIndex.get()).thenReturn(51);
        ReflectionHelper.setFieldValue(mTerminalRequestProcessor, "mTerminalIndex", terminalIndex);

        when(mRequest.getAction()).thenReturn(paymentTerminalAction);
        when(mContext.getString(anyInt(), any(PaymentTerminalAction.class)))
                .then(returnArgumentsAsString());

        mTerminalRequestProcessor
                .processRequestAgainstAvailableTerminals(mContext, mRequest, mCallbacks);

        verify(mCallbacks).onShowProgress();
        verifyLogHelper(logMessage);
        verify(mCallbacks).onRequestFailure(failureMessage);
    }

    @Test
    public void testProcessRequestAgainstAvailableTerminals_ifIndividualRetryNumberReached() {
        String logMessage = "processAction() Exhausted all retry attempts against current " +
                "terminal. SupportedHardwareTerminal = CodeCR950; IndividualRetryCount = 4";

        // Mock maximum number of terminal
        List<SupportedHardware> maxNumberOfTerminals =
                new ArrayList<>(Collections.nCopies(2, SupportedHardware.CodeCR950));
        when(TerminalHelper.getAvailableTerminals()).thenReturn(maxNumberOfTerminals);

        // Mock mIndividualTerminalRetryCount
        AtomicInteger terminalIndex = mock(AtomicInteger.class);
        when(terminalIndex.get()).thenReturn(4);
        ReflectionHelper.setFieldValue(mTerminalRequestProcessor, "mIndividualTerminalRetryCount",
                terminalIndex);

        mTerminalRequestProcessor
                .processRequestAgainstAvailableTerminals(mContext, mRequest, mCallbacks);

        verify(mCallbacks).onShowProgress();

        mLogHelper.verify(() -> LogHelper.write(mTag, logMessage), times(2));

        // Check if mTerminalIndex is incremented
        assertPrivateMember("mTerminalIndex", 2);

        // Check if mIndividualTerminalRetryCount is incremented
        assertPrivateMember("mIndividualTerminalRetryCount", 4);
    }

    @Test
    public void testProcessRequestAgainstAvailableTerminals_ifNewTerminalInstanceIsNotNull() {
        String exhaustedAttemptsLogMessage =
                "processAction() Exhausted all retry attempts against current " +
                        "terminal. SupportedHardwareTerminal = CodeCR950; IndividualRetryCount = 4";
        String forceDisconnectLogMessage =
                "processAction() Sending ForceDisconnect action to terminal: " + mTerminal;

        // Mock maximum number of terminal
        List<SupportedHardware> maxNumberOfTerminals =
                new ArrayList<>(Collections.nCopies(2, SupportedHardware.CodeCR950));
        when(TerminalHelper.getAvailableTerminals()).thenReturn(maxNumberOfTerminals);

        // Mock mIndividualTerminalRetryCount
        AtomicInteger terminalIndex = mock(AtomicInteger.class);
        when(terminalIndex.get()).thenReturn(4);
        ReflectionHelper.setFieldValue(mTerminalRequestProcessor, "mIndividualTerminalRetryCount",
                terminalIndex);

        // Mock mNewTerminalInstance
        ReflectionHelper.setFieldValue(mTerminalRequestProcessor, "mNewTerminalInstance",
                mTerminal);

        mTerminalRequestProcessor
                .processRequestAgainstAvailableTerminals(mContext, mRequest, mCallbacks);

        verify(mCallbacks).onShowProgress();

        mLogHelper.verify(() -> LogHelper.write(mTag, exhaustedAttemptsLogMessage), times(2));
        verifyLogHelper(forceDisconnectLogMessage);

        // Check if mNewTerminalInstance is set to null
        iM3Terminal expectedTerminalInstance =
                ReflectionHelper.getFieldValue(mTerminalRequestProcessor, "mNewTerminalInstance");
        assertNull(expectedTerminalInstance);

        // Check if mTerminalIndex is incremented
        assertPrivateMember("mTerminalIndex", 2);

        // Check if mIndividualTerminalRetryCount is incremented
        assertPrivateMember("mIndividualTerminalRetryCount", 4);
    }

