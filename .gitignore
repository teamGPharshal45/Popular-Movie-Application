class TerminalBatchCloseHelperTest : BaseUnitTest() {
    private lateinit var activity: Activity
    private lateinit var context: Context
    private lateinit var transactionDao: TransactionsDao
    private lateinit var terminal: iM3Terminal
    private lateinit var cursor: Cursor
    private lateinit var handler: Handler
    private lateinit var callbacks: TerminalBatchCloseHelper.TerminalBatchCloseCallbacks
    private lateinit var callbacks2: TerminalBatchCloseHelper.TerminalBatchCloseCallbacks
    private lateinit var batch: TxDbBatch
    private lateinit var mockLooper: Looper
    private lateinit var mockTerminalHelper: MockedStatic<TerminalHelper>
    private lateinit var logHelperMock: MockedStatic<LogHelper>
    private lateinit var helper: TerminalBatchCloseHelper
    private lateinit var batchHelperMock: MockedStatic<BatchHelper>
    private lateinit var MockprefHelper: MockedStatic<PrefHelper>
    private lateinit var logEventHelperMock: MockedStatic<LogEventHelper>
    private val error_msg = "Terminal not configured"
    private lateinit var terminalCallbacks: TerminalBatchCloseHelper.TerminalCallbacks
    private lateinit var terminaltask: TerminalBatchCloseHelper.TerminalBatchCloseTask
    private lateinit var userHelper: MockedStatic<UserHelper>
    private lateinit var mPreferenceManager: MockedStatic<PreferenceManager>
    private lateinit var mFinancialAuditHelper: MockedStatic<FinancialAuditHelper>

    @Before
    override fun setUp() {
        super.setUp()
        context = getApplication()
        activity = mock(Activity::class.java)
        MockprefHelper = mockStatic(PrefHelper::class.java)
        mPreferenceManager = mockStatic(PreferenceManager::class.java)
        transactionDao = mock(TransactionsDao::class.java)
        terminal = mock(iM3Terminal::class.java)
        cursor = mock(Cursor::class.java)
        handler = mock(Handler::class.java)
        callbacks = mock(TerminalBatchCloseHelper.TerminalBatchCloseCallbacks::class.java)
        callbacks2 = mock(TerminalBatchCloseHelper.TerminalBatchCloseCallbacks::class.java)
        mockLooper = mock(Looper::class.java)
        mockTerminalHelper = mockStatic(TerminalHelper::class.java)
        helper = mock(TerminalBatchCloseHelper::class.java, Mockito.CALLS_REAL_METHODS)
        batchHelperMock = mockStatic(BatchHelper::class.java)
        logHelperMock = mockStatic(LogHelper::class.java)
        logEventHelperMock = mockStatic(LogEventHelper::class.java)
        terminalCallbacks = helper.TerminalCallbacks()
        terminaltask = spy(helper.TerminalBatchCloseTask(activity))
        whenever(activity.mainLooper).thenReturn(mockLooper)
        batch = TxDbBatch().apply {
            batchNumber = 1001
        }
        mFinancialAuditHelper = mockStatic(FinancialAuditHelper::class.java)
        whenever(
            FinancialAuditHelper.cardTokenState(any(), any(), any(), any(), any())
        ).thenAnswer { }
        whenever(PreferenceManager.getDefaultSharedPreferences(context)).thenReturn(
            mock(SharedPreferences::class.java)
        )
        whenever(BatchHelper.getCurrentBatchNumber()).thenReturn(10)
        whenever(BatchHelper.getCurrentLocalBatchNumber()).thenReturn(20)
        userHelper = mockStatic(UserHelper::class.java)
        whenever(UserHelper.getUserId()).thenReturn(10)
        helper.mHandler = handler
        helper.mTenderCursor = cursor
        helper.mTerminal = terminal
    }

    @After
    override fun tearDown() {
        super.tearDown()
        mockTerminalHelper.close()
        TerminalBatchCloseHelper.IS_RUNNING.set(false)
        TerminalBatchCloseHelper.sCallbacks = null
        MockprefHelper.close()
        mPreferenceManager.close()
        mFinancialAuditHelper.close()
        logHelperMock.close()
        batchHelperMock.close()
        logEventHelperMock.close()
        userHelper.close()
    }

    @Test
    fun `isRunning returns false when not started`() {
        val result = TerminalBatchCloseHelper.isRunning()
        assertFalse(result)
    }

    @Test
    fun `isRunning returns true when started`() {
        TerminalBatchCloseHelper.IS_RUNNING.set(true)
        val result = TerminalBatchCloseHelper.isRunning()
        assertTrue(result)
    }

    @Test
    fun `addCallbacks creates HashSet when first callback is added`() {
        TerminalBatchCloseHelper.addCallbacks(callbacks)
        assertEquals(1, TerminalBatchCloseHelper.sCallbacks?.size)
        assertTrue(TerminalBatchCloseHelper.sCallbacks?.contains(callbacks) == true)
    }

    @Test
    fun `removeCallbacks removes the callback when called`() {
        TerminalBatchCloseHelper.addCallbacks(callbacks)
        assertEquals(1, TerminalBatchCloseHelper.sCallbacks?.size)
        TerminalBatchCloseHelper.removeCallbacks(callbacks)
        assertNull(TerminalBatchCloseHelper.sCallbacks)
    }

    @Test
    fun `cancel marks sIsCancelled as true when called`() {
        TerminalBatchCloseHelper.cancel()
        assertTrue(TerminalBatchCloseHelper.sIsCancelled)
    }

    @Test
    fun `logEvent writes Log when VerboseLoggingEnabled`() {
        val message = "Test log message"

        helper.logEvent(message)
        logHelperMock.verify { LogHelper.write("TerminalBatchCloseHelper", message) }
    }

    @Test
    fun `auditEvent should save and audit event with BatchNumbers`() {
        val message = "Test audit message"
        helper.auditEvent(message)
        logEventHelperMock.verify {
            LogEventHelper.saveEvent(
                AuditLevel.Debug,
                "TerminalBatchCloseHelper",
                "Test audit message (Batch number: 10 / 20)"
            )
        }
    }

    @Test
    fun `auditSafTenderProcessing logs full Audit Message`() {
        val additionalInfo = mock(TenderAdditionalInfo::class.java)

        whenever(additionalInfo.terminalTenderSafId).thenReturn("SAF123")
        whenever(additionalInfo.terminalTenderId).thenReturn("TID456")

        val tender = mock(TxDbTender::class.java)
        whenever(tender.tenderNumber).thenReturn(100)
        whenever(tender.totalAmount).thenReturn(BigDecimal("5000"))
        whenever(tender.redactedInfo).thenReturn("XXXX")
        whenever(tender.additionalInfo).thenReturn(additionalInfo)

        val response = mock(PaymentTerminalResponse::class.java)
        whenever(response.approvedAmount).thenReturn("5000")
        whenever(response.redactedInfo).thenReturn("RESP_XXXX")
        whenever(response.gatewayCardToken).thenReturn("TOKEN")
        whenever(response.gatewayAuthCode).thenReturn("AUTH123")
        whenever(response.gatewayAuthDateTime).thenReturn(Date(2025, 12, 29, 10, 0))

        val description = "Test SAF processing"
        helper.auditSafTenderProcessing(description, tender, response)

        verify(helper).auditEvent(argThat { message ->
            message.contains("TerminalBatchCloseHelper -> Test SAF processing") &&
                    message.contains("TenderNumber 100") &&
                    message.contains("Tender TotalAmount 5000") &&
                    message.contains("TerminalTenderSafId SAF123") &&
                    message.contains("Response GatewayCardToken TOKEN") &&
                    message.contains("Response GatewayAuthCode AUTH123")
        })
    }

    @Test
    fun `callbackSafUploadInProgress posts and notify callbacks`() {
        TerminalBatchCloseHelper.addCallbacks(callbacks)
        helper.mCompletedCount = 2
        helper.mTotalCount = 3
        val runCaptor = argumentCaptor<Runnable>()

        helper.callbackSafUploadInProgress()
        verify(handler).post(runCaptor.capture())

        runCaptor.firstValue.run()
        verify(callbacks).TerminalBatchCloseOnSafUploadInProgress(2, 3)
    }

    @Test
    fun `callbackSafUploadInProgress does nothing when no callbacks added`() {
        TerminalBatchCloseHelper.removeCallbacks(callbacks)
        helper.mCompletedCount = 2
        helper.mTotalCount = 3
        val runCaptor = argumentCaptor<Runnable>()

        helper.callbackSafUploadInProgress()
        verify(handler).post(runCaptor.capture())

        runCaptor.firstValue.run()
        verifyNoInteractions(callbacks)
    }

    @Test
    fun `callbackSafUploadComplete notify all callbacks with count when called`() {
        TerminalBatchCloseHelper.addCallbacks(callbacks)
        TerminalBatchCloseHelper.addCallbacks(callbacks2)
        helper.mCompletedCount = 4
        helper.mTotalCount = 6

        val captor = argumentCaptor<Runnable>()
        helper.callbackSafUploadComplete()
        verify(handler).post(captor.capture())

        captor.firstValue.run()
        verify(callbacks).TerminalBatchCloseOnSafUploadComplete(4, 6)
        verify(callbacks2).TerminalBatchCloseOnSafUploadComplete(4, 6)
    }

    @Test
    fun `callbackSafUploadComplete does nothing when no callback present`() {
        TerminalBatchCloseHelper.removeCallbacks(callbacks)
        TerminalBatchCloseHelper.removeCallbacks(callbacks2)
        val captor = argumentCaptor<Runnable>()
        helper.callbackSafUploadComplete()

        verify(handler).post(captor.capture())
        captor.firstValue.run()

        verifyNoInteractions(callbacks)
    }

    @Test
    fun `callbackSafTendersNotFound notify all callbacks`() {
        TerminalBatchCloseHelper.addCallbacks(callbacks)
        TerminalBatchCloseHelper.addCallbacks(callbacks2)
        helper.callbackSafTendersNotFound()
        val captor = argumentCaptor<Runnable>()
        verify(handler).post(captor.capture())
        captor.firstValue.run()
        verify(callbacks).TerminalBatchCloseOnSafTendersNotFound()
        verify(callbacks2).TerminalBatchCloseOnSafTendersNotFound()

    }

