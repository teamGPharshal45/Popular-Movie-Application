    @Test
    fun `callbackTerminalConfigurationError notify all callbacks with error msg when called`() {
        TerminalBatchCloseHelper.addCallbacks(callbacks)
        TerminalBatchCloseHelper.addCallbacks(callbacks2)
        helper.callbackTerminalConfigurationError(error_msg)
        val captor = argumentCaptor<Runnable>()
        verify(handler).post(captor.capture())
        captor.firstValue.run()

        verify(callbacks).TerminalBatchCloseOnTerminalConfigurationError(error_msg)
        verify(callbacks2).TerminalBatchCloseOnTerminalConfigurationError(error_msg)
    }

    @Test
    fun `UploadSafTenders response sets payment response and clears wait when called`() {
        val response = mock(PaymentTerminalResponse::class.java)
        whenever(response.action).thenReturn(PaymentTerminalAction.UploadSafTenders)
        helper.mWaitingForTerminalResponse = true

        terminalCallbacks.iM3TerminalOnResponse(response)

        assertEquals(response, helper.mPaymentTerminalResponse)
        assertFalse(helper.mWaitingForTerminalResponse)
    }

    @Test
    fun `GetSafTender response sets payment response`() {
        val response = mock(PaymentTerminalResponse::class.java)
        whenever(response.action).thenReturn(PaymentTerminalAction.GetSafTender)
        terminalCallbacks.iM3TerminalOnResponse(response)

        assertEquals(response, helper.mPaymentTerminalResponse)
        assertFalse(helper.mWaitingForTerminalResponse)
    }

    @Test
    fun `CloseBatch response sets batch close success`() {
        val response = mock(PaymentTerminalResponse::class.java)
        whenever(response.action).thenReturn(PaymentTerminalAction.CloseBatch)
        whenever(response.isTerminalBatchEmpty).thenReturn(true)
        helper.mBatchCloseSuccess = false
        helper.mWaitingForTerminalResponse = true
        terminalCallbacks.iM3TerminalOnResponse(response)
        assertTrue(helper.mBatchCloseSuccess)
        assertFalse(helper.mWaitingForTerminalResponse)
    }

    @Test
    fun `ClearBatch response also sets batch close success`() {
        val response = mock(PaymentTerminalResponse::class.java)
        whenever(response.action).thenReturn(PaymentTerminalAction.ClearBatch)
        whenever(response.isTerminalBatchEmpty).thenReturn(true)
        terminalCallbacks.iM3TerminalOnResponse(response)
        assertTrue(helper.mBatchCloseSuccess)
    }

    @Test
    fun `Terminal error sets error flags and clear wait`() {
        val error = mock(PaymentTerminalError::class.java)
        whenever(error.friendlyMessage).thenReturn("Error")
        whenever(error.detailedMessage).thenReturn("Details")
        helper.mWaitingForTerminalResponse = true
        terminalCallbacks.iM3TerminalOnError(error)

        assertTrue(helper.mHasError)
        assertFalse(helper.mBatchCloseSuccess)
        assertFalse(helper.mWaitingForTerminalResponse)
        assertFalse(helper.mReceivedSafNotFoundResponseForBatchAction)
    }

    @Test
    fun `wasClearBatchSafTenderNotFound returns correct flag when called`() {
        terminaltask.mWasClearBatchSafTenderNotFound = true
        assertTrue(terminaltask.wasClearBatchSafTenderNotFound())

        terminaltask.mWasClearBatchSafTenderNotFound = false
        assertFalse(terminaltask.wasClearBatchSafTenderNotFound())
    }

    @Test
    fun `handleSafUploadResponse triggers error when response is null`() {
        doNothing().whenever(helper).callbackOnError()
        terminaltask.handleSafUploadResponse(null)

        verify(helper).callbackOnError()
    }

    @Test
    fun `handleSafUploadResponse sets flag when saf not found`() {
        val response = mock(PaymentTerminalResponse::class.java)
        whenever(response.isSafTenderNotFound).thenReturn(true)

        helper.mTotalCount = 0
        helper.mHasError = false

        doNothing().whenever(helper).callbackSafUploadComplete()
        doNothing().whenever(terminaltask).closeBatch()
        terminaltask.handleSafUploadResponse(response)

        assertTrue(helper.mReceivedSafNotFoundResponseForBatchAction)
    }

    @Test
    fun `handleSafUploadResponse triggers updateRemainingTenders when valid response is passed`() {
        val response = mock(PaymentTerminalResponse::class.java)
        whenever(response.isSafTenderNotFound).thenReturn(false)

        doNothing().whenever(terminaltask).updateRemainingTenders()
        terminaltask.handleSafUploadResponse(response)

        verify(terminaltask).updateRemainingTenders()
    }

    @Test
    fun `handleSafUploadResponse triggers onCancelled callback when saf not found and cancelled`() {
        val response = mock(PaymentTerminalResponse::class.java)
        whenever(response.isSafTenderNotFound).thenReturn(true)
        TerminalBatchCloseHelper.sIsCancelled = true
        helper.mHasError = false
        helper.mTotalCount = 5
        terminaltask.handleSafUploadResponse(response)

        verify(helper).callbackOnCancelled()
    }

    @Test
    fun `handleSafUploadResponse triggers updateRemainingTenders when saf not found`() {
        val response = mock(PaymentTerminalResponse::class.java)
        whenever(response.isSafTenderNotFound).thenReturn(true)
        TerminalBatchCloseHelper.sIsCancelled = false
        helper.mTotalCount = 2

        doNothing().whenever(terminaltask).updateRemainingTenders()
        terminaltask.handleSafUploadResponse(response)

        verify(terminaltask).updateRemainingTenders()
    }

    @Test
    fun `handleTenderResponse updates db and increment count when saf uploaded`() {
        val response = mock(PaymentTerminalResponse::class.java)
        val tender = mock(TxDbTender::class.java)
        val transactionsDao = mock(TransactionsDao::class.java)
        whenever(response.isSafTenderUploaded).thenReturn(true)
        whenever(response.isSafTenderDeclined).thenReturn(false)
        whenever(response.gatewayAuthCode).thenReturn("AUTH123")
        whenever(tender.transactionNumber).thenReturn(1001L)
        whenever(tender.tenderNumber).thenReturn(1)
        whenever(tender.additionalInfo).thenReturn(TenderAdditionalInfo())

        helper.mCompletedCount = 0
        helper.mTransactionsDao = transactionsDao

        terminaltask.handleTenderResponse(tender, response)
        verify(transactionsDao).updateTender(
            eq(1001L),
            eq(1),
            eq(TenderRecordStatus.Finalized),
            eq(TenderCreditStatusType.Completed),
            eq("AUTH123"),
            any<TenderAdditionalInfo>(),
            any<Date>()
        )
    }

    @Test
    fun `handleTenderResponse set Declined status when saf uploaded and declined`() {
        val response = mock(PaymentTerminalResponse::class.java)
        val tender = mock(TxDbTender::class.java)
        val transactionsDao = mock(TransactionsDao::class.java)
        whenever(response.isSafTenderUploaded).thenReturn(true)
        whenever(response.isSafTenderDeclined).thenReturn(true)
        whenever(response.gatewayCardToken).thenReturn(null)
        whenever(response.gatewayAuthCode).thenReturn("DECL123")
        whenever(tender.transactionNumber).thenReturn(1001L)
        whenever(tender.tenderNumber).thenReturn(1)
        whenever(tender.additionalInfo).thenReturn(TenderAdditionalInfo())
        helper.mCompletedCount = 0
        helper.mTransactionsDao = transactionsDao

        terminaltask.handleTenderResponse(tender, response)
        verify(transactionsDao).updateTender(
            eq(1001L),
            eq(1),
            eq(TenderRecordStatus.Finalized),
            eq(TenderCreditStatusType.Declined),
            eq("DECL123"),
            any<TenderAdditionalInfo>(),
            any<Date>()
        )
        assertEquals(1, helper.mCompletedCount)
    }

    @Test
    fun `handleTenderResponse does nothing when saf not uploaded`() {
        val response = mock(PaymentTerminalResponse::class.java)
        val tender = mock(TxDbTender::class.java)
        val transactionsDao = mock(TransactionsDao::class.java)

        helper.mTransactionsDao = transactionsDao
        whenever(response.isSafTenderUploaded).thenReturn(false)
        whenever(response.isSafTenderNotFound).thenReturn(false)
        helper.mCompletedCount = 0;
        terminaltask.handleTenderResponse(tender, response)

        verifyNoInteractions(transactionsDao)
        assertEquals(0, helper.mCompletedCount)
    }

    @Test
    fun `getUpdatedAdditionalInfo updates all non-null fields when correct tender passed`() {
        val tender = TxDbTender().apply {
            additionalInfo = TenderAdditionalInfo().apply {
                gatewayIdentifier = "oldId"
                gatewayGroupIdentifier = "oldGroup"
                gatewayAuthDateTime = Date(2026, 1, 2, 9, 10)
                gatewayAuthResponse = "oldResponse"
                gatewayCardToken = "oldToken"
                swiperType = SwiperType.PaxA920SmartTerminal
            }
        }
        val response = mock(PaymentTerminalResponse::class.java)
        whenever(response.gatewayIdentifier).thenReturn("newId")
        whenever(response.gatewayGroupIdentifier).thenReturn("newGroup")
        whenever(response.gatewayAuthDateTime).thenReturn(Date(2026, 1, 2, 9, 15))
        whenever(response.gatewayAuthResponse).thenReturn("newResponse")
        whenever(response.gatewayCardToken).thenReturn("newToken")
        whenever(response.swiperType).thenReturn(SwiperType.PaxA920SmartTerminal)

        val updatedInfo = terminaltask.getUpdatedAdditionalInfo(tender, response)

        assertEquals("newId", updatedInfo.gatewayIdentifier)
        assertEquals(response.swiperType, SwiperType.PaxA920SmartTerminal)
    }

    @Test
    fun `getUpdatedAdditionalInfo preserves old response when new response is null`() {
        val tender = TxDbTender().apply {
            additionalInfo = TenderAdditionalInfo().apply {
                gatewayIdentifier = "oldId"
                gatewayGroupIdentifier = "oldGroup"
                gatewayAuthDateTime = Date(2026, 1, 2, 9, 10)
                gatewayAuthResponse = "oldResponse"
                gatewayCardToken = "oldToken"
                swiperType = SwiperType.PaxA920SmartTerminal
            }
        }
        val response = mock(PaymentTerminalResponse::class.java)
        whenever(response.gatewayIdentifier).thenReturn(null)
        whenever(response.gatewayGroupIdentifier).thenReturn(null)
        whenever(response.gatewayAuthDateTime).thenReturn(null)
        whenever(response.gatewayAuthResponse).thenReturn(null)
        whenever(response.gatewayCardToken).thenReturn(null)
        whenever(response.swiperType).thenReturn(null)

        val updatedInfo = terminaltask.getUpdatedAdditionalInfo(tender, response)

        assertEquals(updatedInfo.gatewayIdentifier, "oldId")
        assertEquals(updatedInfo.gatewayGroupIdentifier, "oldGroup")
    }

    @Test
    fun `closeBatch calls callbackOnComplete on success`() {
        helper.mBatchCloseSuccess = true
        TerminalBatchCloseHelper.sIsCancelled = false
        doAnswer {
            helper.mWaitingForTerminalResponse = false
            null
        }.whenever(terminal).sendRequest(any())
        terminaltask.closeBatch()

        verify(helper).callbackOnComplete()
    }

    @Test
    fun `closeBatch calls callbackOnCancelled when cancelled`() {
        helper.mBatchCloseSuccess = false
        TerminalBatchCloseHelper.sIsCancelled = true
        doAnswer {
            helper.mWaitingForTerminalResponse = false
            null
        }.whenever(terminal).sendRequest(any())
        terminaltask.closeBatch()

        verify(helper).callbackOnCancelled()
    }

    @Test
    fun `closeBatch calls callbackOnError when fails`() {
        helper.mBatchCloseSuccess = false
        TerminalBatchCloseHelper.sIsCancelled = false
        doAnswer {
            helper.mWaitingForTerminalResponse = false
            null
        }.whenever(terminal).sendRequest(any())
        terminaltask.closeBatch()

        verify(helper).callbackOnError()
    }
